/* Value-based processor-owned byte-range fast-span admission (proved equivalent
 * to allocation-limits.inc:1179-1197 in CompiledHostRefinementV2.lean & CBMC).
 * Dereferencing (*hp_ptr, *fp_ptr, *att_ptr) lets GCC fold *(&___hp) back to
 * register-allocated ___hp, ___fp, ___demand_attempt on the fast path, keeping
 * address-taken temporaries confined to the cold slow-path branch. */
#define ___group_demand_enter(ps,hp_ptr,fp_ptr,sw,hw,pt,att_ptr) \
  ({ \
    ___processor_state const ___gd_ps = (ps); \
    ___WORD *___gd_h = *(hp_ptr); \
    ___WORD *___gd_f = *(fp_ptr); \
    ___SIZE_TS const ___gd_sw = (sw); \
    ___SIZE_TS const ___gd_hw = (hw); \
    int ___gd_ok = 0; \
    if (__builtin_expect(___gd_ps != 0 && ___gd_ps->context != 0 && \
                         ___gd_f != 0 && ___gd_h != 0 && \
                         ___gd_sw >= 0 && ___gd_hw >= 0, 1)) { \
      ___UWORD const ___gd_sd = ___CAST(___UWORD, ___gd_f) - ___gd_ps->stack_fast_floor_b; \
      ___UWORD const ___gd_hd = ___CAST(___UWORD, ___gd_h) - ___gd_ps->heap_fast_lo_b; \
      if (__builtin_expect( \
            ___gd_sd < ___gd_ps->stack_fast_limit_b && \
            ___gd_sd >= ((___UWORD)___gd_sw * sizeof(___WORD)) && \
            (___gd_hw == 0 || \
             (___gd_hd < ___gd_ps->heap_fast_bytes && \
