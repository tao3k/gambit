#endif
  return ___COMPARE_AND_SWAP_WORD(___CAST(___VOLATILE ___WORD*, slot), oldval, val);
}

/*
 * Unified SRFI-230 C23 atomic publication and GC write-barrier helpers.
 * Integrates SRFI-230 memory-order semantics with Gambit's SATB and
 * generational write barriers.
 */
#define ___SRFI230_ORDER_RELAXED 0
#define ___SRFI230_ORDER_ACQUIRE 1
#define ___SRFI230_ORDER_RELEASE 2
#define ___SRFI230_ORDER_ACQ_REL 3
#define ___SRFI230_ORDER_SEQ_CST 4

___ORDERED_WORD_INLINE int ___srfi230_to_gcc_memorder (int order)
{
#if defined(__ATOMIC_RELAXED) && defined(__ATOMIC_SEQ_CST)
  switch (order)
    {
    case ___SRFI230_ORDER_RELAXED: return __ATOMIC_RELAXED;
    case ___SRFI230_ORDER_ACQUIRE: return __ATOMIC_ACQUIRE;
    case ___SRFI230_ORDER_RELEASE: return __ATOMIC_RELEASE;
    case ___SRFI230_ORDER_ACQ_REL: return __ATOMIC_ACQ_REL;
    default:                       return __ATOMIC_SEQ_CST;
    }
#else
  (void)order;
  return 0;
#endif
}

___ORDERED_WORD_INLINE void ___gc_srfi230_fence (int order)
{
#if defined(__ATOMIC_RELAXED) && defined(__ATOMIC_SEQ_CST)
  __atomic_thread_fence(___srfi230_to_gcc_memorder(order));
#else
  (void)order;
  ___SYNC_MEMORY();
#endif
}

___ORDERED_WORD_INLINE ___SCMOBJ ___gc_srfi230_box_load
   (___SCMOBJ box,
    int order)
{
  ___WORD *slot = &___BODY_AS(box, ___tBOXVALUES)[0];
