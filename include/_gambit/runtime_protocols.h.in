___ORDERED_WORD_INLINE ___SCMOBJ ___gc_satb_read_barrier
   (___processor_state ___ps,
    ___SCMOBJ val,
    void (*satb_val) ___P((___processor_state, ___SCMOBJ), ()))
{
#ifndef ___DISABLE_GENERATIONAL_GC
  if (___EXPECT_FALSE(___ps->mem.satb_active_ != 0 && ___MEM_ALLOCATED(val)))
    satb_val(___ps, val);
#else
  (void)___ps; (void)satb_val;
#endif
  return val;
}

___ORDERED_WORD_INLINE ___WORD ___gc_vector_cas_barrier
   (___processor_state ___ps,
    ___SCMOBJ v,
    ___SCMOBJ i,
    ___SCMOBJ val,
    ___SCMOBJ oldval,
    void (*wb_slow) ___P((___processor_state, ___SCMOBJ, ___WORD*), ()),
    void (*satb_val) ___P((___processor_state, ___SCMOBJ), ()))
{
  ___WORD *slot = ___FXINDX_WORD(___BODY_AS(v, ___tVECTOR), i);
  ___WORD cur = ___WORD_LOAD_ACQUIRE(___CAST(___VOLATILE ___WORD*, slot));
  if (cur != ___CAST(___WORD, oldval))
    return cur;
#ifndef ___DISABLE_GENERATIONAL_GC
  if (___EXPECT_FALSE(___ps->mem.satb_active_ != 0 && ___MEM_ALLOCATED(oldval)))
    satb_val(___ps, oldval);
  if (___MEM_ALLOCATED(val))
    {
      ___UWORD a = ___CAST(___UWORD, slot);
      ___UWORD lo = ___CAST(___UWORD, ___ps->mem.alloc_heap_start_);
      ___UWORD hi = ___CAST(___UWORD, ___ps->mem.alloc_heap_limit_);
      if (___EXPECT_FALSE(a - lo >= hi - lo &&
                          a - ___ps->mem.wb_last_card_lo_ >= (___CAST(___UWORD, ___GC_CARD_WORDS) * ___WS)))
        wb_slow(___ps, v, slot);
    }
#else
  (void)___ps; (void)wb_slow; (void)satb_val;
#endif
  return ___COMPARE_AND_SWAP_WORD(___CAST(___VOLATILE ___WORD*, slot), oldval, val);
}

___ORDERED_WORD_INLINE ___WORD ___gc_structure_cas_barrier
   (___processor_state ___ps,
    ___SCMOBJ x,
    ___SCMOBJ val,
    ___SCMOBJ oldval,
    ___SCMOBJ i,
    void (*wb_slow) ___P((___processor_state, ___SCMOBJ, ___WORD*), ()),
    void (*satb_val) ___P((___processor_state, ___SCMOBJ), ()))
{
  ___WORD *slot = ___FXINDX_WORD(___BODY_AS(x, ___tSTRUCTURE), i);
  ___WORD cur = ___WORD_LOAD_ACQUIRE(___CAST(___VOLATILE ___WORD*, slot));
  if (cur != ___CAST(___WORD, oldval))
    return cur;
#ifndef ___DISABLE_GENERATIONAL_GC
  if (___EXPECT_FALSE(___ps->mem.satb_active_ != 0 && ___MEM_ALLOCATED(oldval)))
    satb_val(___ps, oldval);
  if (___MEM_ALLOCATED(val))
    {
      ___UWORD a = ___CAST(___UWORD, slot);
      ___UWORD lo = ___CAST(___UWORD, ___ps->mem.alloc_heap_start_);
      ___UWORD hi = ___CAST(___UWORD, ___ps->mem.alloc_heap_limit_);
      if (___EXPECT_FALSE(a - lo >= hi - lo &&
                          a - ___ps->mem.wb_last_card_lo_ >= (___CAST(___UWORD, ___GC_CARD_WORDS) * ___WS)))
        wb_slow(___ps, x, slot);
