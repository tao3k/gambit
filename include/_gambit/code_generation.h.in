/*---------------------------------------------------------------------------*/

#ifdef __GNUC__
#if ___GNUC_VERSION >= 300000
#undef ___USE_builtin_expect
#define ___USE_builtin_expect
#endif
#endif

#ifdef __clang__
#if __has_builtin(__builtin_expect)
#undef ___USE_builtin_expect
#define ___USE_builtin_expect
#endif
#endif

#ifdef ___DONT_USE_builtin_expect
#undef ___USE_builtin_expect
#endif

#ifdef ___USE_builtin_expect
#define ___EXPECT_TRUE(x) __builtin_expect((x),1)
#define ___EXPECT_FALSE(x) __builtin_expect((x),0)
#else
#define ___EXPECT_TRUE(x) (x)
#define ___EXPECT_FALSE(x) (x)
#endif

/*---------------------------------------------------------------------------*/

#ifdef __GNUC__
#if ___GNUC_VERSION > 500000
#undef ___USE_builtin_op_overflow
#define ___USE_builtin_op_overflow
#undef ___USE_builtin_popcount
#define ___USE_builtin_popcount
#undef ___USE_builtin_ffs
#define ___USE_builtin_ffs
#undef ___USE_builtin_clrsb
#define ___USE_builtin_clrsb
#endif
#endif

#ifdef __clang__
#if __has_builtin(__builtin_add_overflow) && __has_builtin(__builtin_sub_overflow) && __has_builtin(__builtin_mul_overflow)
#undef ___USE_builtin_op_overflow
#define ___USE_builtin_op_overflow
#endif
#if __has_builtin(__builtin_popcount)
#undef ___USE_builtin_popcount
#define ___USE_builtin_popcount
#endif
#if __has_builtin(__builtin_ffs)
#undef ___USE_builtin_ffs
#define ___USE_builtin_ffs
#endif
#if __has_builtin(__builtin_clrsb)
#undef ___USE_builtin_clrsb
#define ___USE_builtin_clrsb
#endif
#endif

#ifdef ___CPU_x86
#if __has_builtin(__builtin_ia32_rdtscp)
#undef ___USE___builtin_ia32_rdtscp
#define ___USE___builtin_ia32_rdtscp
#endif
#endif

#ifdef ___CPU_x86
#if __has_builtin(__builtin_readcyclecounter)
#undef ___USE___builtin_readcyclecounter
#define ___USE___builtin_readcyclecounter
#endif
#endif

#ifdef ___DONT_USE_builtin_op_overflow
#undef ___USE_builtin_op_overflow
#endif

#ifdef ___DONT_USE_builtin_popcount
#undef ___USE_builtin_popcount
#endif

#ifdef ___DONT_USE_builtin_ffs
#undef ___USE_builtin_ffs
#endif

#ifdef ___DONT_USE_builtin_clrsb
#undef ___USE_builtin_clrsb
#endif

#ifdef ___DONT_USE___builtin_ia32_rdtscp
#undef ___USE___builtin_ia32_rdtscp
#endif

#ifdef ___DONT_USE___builtin_readcyclecounter
#undef ___USE___builtin_readcyclecounter
#endif


