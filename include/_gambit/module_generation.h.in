#define ___OFD(kind,fs,link,gcmap)___IFD(kind,0,0,0)
#define ___IS_IFD(x)((x)&((1<<___KIND_WIDTH)-1))

#define ___IFD_KIND(x)((x)&((1<<___KIND_WIDTH)-1))
#define ___IFD_FS(x)(((x)>>___KIND_WIDTH)&((1<<___IFD_FS_WIDTH)-1))
#define ___IFD_LINK(x)(((x)>>(___IFD_FS_WIDTH+___KIND_WIDTH))&((1<<___IFD_FS_WIDTH)-1))
#define ___IFD_GCMAP(x)(((x)>>(2*___IFD_FS_WIDTH+___KIND_WIDTH))&((1<<(32-(2*___IFD_FS_WIDTH+___KIND_WIDTH)))-1))

