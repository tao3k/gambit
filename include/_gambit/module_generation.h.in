#define ___INTERRUPT_REQ(flags) \
(___INTERRUPT_AFTER_MASKING(flags) != ___FIX(0))

#define ___STACK_TRIP_ON_IF_INTERRUPT_REQ() \
if (___INTERRUPT_REQ(___INTERRUPT_FLAGS())) \
  ___STACK_TRIP_ON()

#define ___INTERRUPT_MASK_SET(mask) \
do { \
  ___ps->intr_mask = (mask); \
  ___STACK_TRIP_ON_IF_INTERRUPT_REQ(); \
} while (0)

#define ___STACK_TRIP_ON()___ps->stack_trip = ___ps->context->stack_start
#define ___STACK_TRIP_OFF()___ps->stack_trip = ___ps->context->stack_limit
#define ___STACK_TRIPPED (___fp < ___ps->stack_trip)

