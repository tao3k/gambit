#ifdef ___SUPPORT_LOWLEVEL_EXEC

#ifdef ___CPU_x86

/* Useful to have constant bit pattern in low 16 bits of pstate */
#define ___PSTATE_ALIGN_MULTIPLIER (1<<16)
#define ___PSTATE_ALIGN_MODULUS    0x8888

#ifdef ___CPU_x86_32

#define ___CLO_LOWLEVEL_TRAMPOLINE_SIZE 2
#define ___CLO_LOWLEVEL_TRAMPOLINE_SETUP(ptr,lbl) \
do { \
     /* generate x86-32 instruction: call lbl */ \
     ___WORD dist = ___CAST(___WORD, \
                            ___CAST(___UWORD,lbl) - \
                            (___CAST(___UWORD,ptr) + ___WS + ___tSUBTYPED + 5)); \
     (ptr)[___LABEL_LOWLEVEL_CODE] = (0xe8L << (8*___tSUBTYPED)) \
                                     + (dist << (8*(___tSUBTYPED+1))); \
     (ptr)[___LABEL_LOWLEVEL_CODE+1] = (dist >> (8*(___WS-(___tSUBTYPED+1)))); \
   } while (0)

#define ___LABEL_LOWLEVEL_TRAMPOLINE_SIZE 1
#define ___LABEL_LOWLEVEL_TRAMPOLINE_SETUP(ptr) \
do { \
     /* generate x86-32 instruction: call *-4(%ecx) */ \
     (ptr)[___LABEL_LOWLEVEL_CODE] = 0xfc51ff << (8*___tSUBTYPED); \
   } while (0)

#endif

#ifdef ___CPU_x86_64

#define ___CLO_LOWLEVEL_TRAMPOLINE_SIZE 1
#define ___CLO_LOWLEVEL_TRAMPOLINE_SETUP(ptr,lbl) \
do { \
     /* generate x86-64 instruction: call *-15(%rip) */ \
     (ptr)[___LABEL_LOWLEVEL_CODE] = 0xfffffff115ffL << (8*___tSUBTYPED); \
   } while (0)

#define ___LABEL_LOWLEVEL_TRAMPOLINE_SIZE 1
#define ___LABEL_LOWLEVEL_TRAMPOLINE_SETUP(ptr) \
do { \
     /* generate x86-64 instruction: call *-8(%rcx) */ \
     (ptr)[___LABEL_LOWLEVEL_CODE] = 0xf851ff << (8*___tSUBTYPED); \
   } while (0)

#endif

#endif

#ifdef ___CPU_arm

#define ___CLO_LOWLEVEL_TRAMPOLINE_SIZE 2
#define ___CLO_LOWLEVEL_TRAMPOLINE_SETUP(ptr,lbl) \
do { \
     /* generate ARM THUMB2 instructions: mov r4,pc ; ldr pc,[r4,#-8] */ \
     (ptr)[___LABEL_LOWLEVEL_CODE] = 0xf854467cL; \
     (ptr)[___LABEL_LOWLEVEL_CODE+1] = 0x0000fc08L; \
   } while (0)

#define ___LABEL_LOWLEVEL_TRAMPOLINE_SIZE 1
#define ___LABEL_LOWLEVEL_TRAMPOLINE_SETUP(ptr) \
do { \
     /* generate ARM THUMB2 instructions: ldr r7,[r5] ; blx r7 */ \
     (ptr)[___LABEL_LOWLEVEL_CODE] = 0x47b8682fL; \
   } while (0)

#endif

#ifdef ___CPU_riscv

#if __riscv_xlen == 64

#define ___CLO_LOWLEVEL_TRAMPOLINE_SIZE 2
#define ___CLO_LOWLEVEL_TRAMPOLINE_SETUP(ptr,lbl) \
do { \
     /* XXX generate RISC-V instructions: auipc s6, 0x0; ld s6, -16(s6); jr s6 */ \
     (ptr)[___LABEL_LOWLEVEL_CODE] = 0xff0b3b0300000b17L; \
     (ptr)[___LABEL_LOWLEVEL_CODE+1] = 0x000b0067; \
   } while (0)

#define ___LABEL_LOWLEVEL_TRAMPOLINE_SIZE 1
#define ___LABEL_LOWLEVEL_TRAMPOLINE_SETUP(ptr) \
do { \
     /* generate RISC-V instructions: ld s7, 0(s10); jalr s7 */ \
     (ptr)[___LABEL_LOWLEVEL_CODE] = 0x000b80e7000d3b83L; \
   } while (0)

#else

#define ___CLO_LOWLEVEL_TRAMPOLINE_SIZE 3
#define ___CLO_LOWLEVEL_TRAMPOLINE_SETUP(ptr,lbl) \
do { \
     /* generate RISC-V instructions: auipc s6, 0x0; lw s6, -8(s6); jr s6 */ \
     (ptr)[___LABEL_LOWLEVEL_CODE] = 0x00000b17; \
     (ptr)[___LABEL_LOWLEVEL_CODE+1] = 0xff8b2b03; \
     (ptr)[___LABEL_LOWLEVEL_CODE+2] = 0x000b0067; \
   } while (0)

#define ___LABEL_LOWLEVEL_TRAMPOLINE_SIZE 2
#define ___LABEL_LOWLEVEL_TRAMPOLINE_SETUP(ptr) \
do { \
     /* generate RISC-V instructions: lw s7, 0(s10); jalr s7 */ \
     (ptr)[___LABEL_LOWLEVEL_CODE] = 0x000d2b83; \
     (ptr)[___LABEL_LOWLEVEL_CODE+1] = 0x000b80e7; \
   } while (0)

#endif

#endif

#endif

