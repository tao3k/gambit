#ifdef ___USE_THREAD_LOCAL_STORAGE_GETTER_SETTER

/* Use thread local storage getter/setter */

#define ___GET_REAL_PSTATE() ___CAST(___processor_state,___EXT(___get_tls_ptr) ())
#define ___SET_REAL_PSTATE(ps) ___set_tls_ptr(___CAST(void*,ps))

#else

/* Use thread local storage class */

#define ___GET_REAL_PSTATE() ___CAST(___processor_state,___tls_ptr)
#define ___SET_REAL_PSTATE(ps) ___tls_ptr = ___CAST(void*,ps)

#endif

