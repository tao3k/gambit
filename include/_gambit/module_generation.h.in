___ROUND_TO_MULT(fs,___FRAME_ALIGN)+___FRAME_SPACE(___NB_GVM_REGS+1)-___FRAME_RESERVE

/* One decoded frame contract for stack roots, heap frames and restoration.
 * Input descriptors are trusted, live module metadata. This decoder neither
 * validates an arbitrary pointer nor extends the lifetime of its module.
 */
typedef struct ___frame_descriptor_struct
  {
    int kind;
    int stored_fs;
    int fs;
    int link;
    ___WORD gcmap;
    ___WORD *nextgcmap;
  } ___frame_descriptor;

#if defined(__GNUC__) || defined(__clang__)
#define ___FRAME_INLINE static __inline__
#elif defined(_MSC_VER)
#define ___FRAME_INLINE static __inline
#elif defined(__STDC_VERSION__) && __STDC_VERSION__ >= 199901L
#define ___FRAME_INLINE static inline
#else
#define ___FRAME_INLINE static
#endif

___FRAME_INLINE ___frame_descriptor ___decode_frame_descriptor
   ___P((___WORD descr, int internal),
        (descr, internal)
___WORD descr;
int internal;)
{
  ___frame_descriptor frame;

  if (___IS_IFD(descr))
    {
      frame.kind = ___IFD_KIND(descr);
      frame.stored_fs = ___IFD_FS(descr);
      frame.link = ___IFD_LINK(descr);
      frame.gcmap = ___IFD_GCMAP(descr);
      frame.nextgcmap = 0;
    }
  else
    {
      ___WORD *table = ___CAST(___WORD*,descr);
      ___WORD header = *table++;
      frame.kind = ___OFD_KIND(header);
      frame.stored_fs = ___OFD_FS(header);
      frame.link = ___OFD_LINK(header);
      frame.gcmap = *table++;
      frame.nextgcmap = table;
    }

  frame.fs = internal ? ___RETI_CFS_TO_FS(frame.stored_fs) : frame.stored_fs;
  return frame;
}

/* Physical root coordinates are one-based.  nextgcmap starts AFTER the first
 * word, so slot WORD_WIDTH+1 uses nextgcmap[0].  Cast before shifting: a live
 * root at the native sign bit is valid metadata, not a signed-int mask.
 */
___FRAME_INLINE int ___frame_slot_live
   ___P((const ___frame_descriptor *frame, int slot),
        (frame, slot)
const ___frame_descriptor *frame;
int slot;)
{
  int bit;
  ___UWORD word;

  if (slot <= 0 || slot > frame->fs)
    return 0;
  bit = slot - 1;
  word = ___CAST(___UWORD,
           bit < ___WORD_WIDTH
           ? frame->gcmap
           : frame->nextgcmap[(bit >> ___LOG_WORD_WIDTH) - 1]);
  return ___CAST(int, (word >> (bit & (___WORD_WIDTH-1))) & 1);
}

/* Borrowed, nonallocating scan state.  It never outlives the descriptor's
 * module or crosses a safepoint.  Runs preserve mark_array's bulk marking.
 */
typedef struct ___frame_root_cursor_struct
  {
    ___UWORD bits;
    const ___WORD *next;
    int slot;
    int fs;
    int excluded_slot; /* structural link has a separate traversal contract */
  } ___frame_root_cursor;

___FRAME_INLINE ___frame_root_cursor ___frame_root_begin
   ___P((const ___frame_descriptor *frame),
        (frame)
const ___frame_descriptor *frame;)
{
  ___frame_root_cursor cursor;
  cursor.bits = ___CAST(___UWORD, frame->gcmap);
  cursor.next = frame->nextgcmap;
  cursor.slot = 1;
  cursor.fs = frame->fs;
  cursor.excluded_slot = 0;
  return cursor;
}

___FRAME_INLINE ___frame_root_cursor ___frame_ordinary_root_begin
   ___P((const ___frame_descriptor *frame), (frame)
const ___frame_descriptor *frame;)
{
  ___frame_root_cursor cursor = ___frame_root_begin(frame);
  cursor.excluded_slot = frame->link+1;
  return cursor;
}

___FRAME_INLINE void ___frame_root_advance
   ___P((___frame_root_cursor *cursor),
        (cursor)
___frame_root_cursor *cursor;)
{
  cursor->bits >>= 1;
  cursor->slot++;
  if (cursor->slot <= cursor->fs &&
      ((cursor->slot-1) & (___WORD_WIDTH-1)) == 0)
    cursor->bits = ___CAST(___UWORD, *cursor->next++);
}

___FRAME_INLINE int ___frame_root_next_run
   ___P((___frame_root_cursor *cursor, int *first, int *past),
        (cursor, first, past)
___frame_root_cursor *cursor;
int *first;
int *past;)
{
  while (cursor->slot <= cursor->fs &&
         (!(cursor->bits & 1) || cursor->slot == cursor->excluded_slot))
    ___frame_root_advance (cursor);
  if (cursor->slot > cursor->fs)
    return 0;
  *first = cursor->slot;
  do
    ___frame_root_advance (cursor);
  while (cursor->slot <= cursor->fs && (cursor->bits & 1) &&
         cursor->slot != cursor->excluded_slot);
  *past = cursor->slot;
  return 1;
}

