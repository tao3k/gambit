#ifndef ___SUPPORT_PSTATE_BIND

#define ___GET_PSTATE() ___GET_REAL_PSTATE()

#else

#define ___GET_PSTATE() ___GET_REAL_PSTATE()->pstate_binding
#define ___BEGIN_PSTATE_BIND(ps) \
do { \
  ___processor_state ___old_pstate = ___GET_REAL_PSTATE()->pstate_binding; \
  ___GET_REAL_PSTATE()->pstate_binding = ps
#define ___END_PSTATE_BIND() \
  ___GET_REAL_PSTATE()->pstate_binding = ___old_pstate; \
} while (0)

#endif

#ifndef ___DEFINE_THREAD_LOCAL_STORAGE_GETTER_SETTER

/*
 * ___GET_PSTATE is probably fast, so it is acceptable to get the processor
 * state pointer at the top of every function that needs to access the
 * processor state.
 */

#define ___PSGET ___processor_state ___ps = ___PSTATE;

#define ___PSDNC
#define ___PSVNC

#define ___PSD
#define ___PSV
#define ___PSDKR

#define ___PSANC(ps)
#define ___PSA(ps)

#else

/*
 * ___GET_PSTATE is probably slow, so the processor state pointer will be
 * propagated from one function to its callees when possible.
