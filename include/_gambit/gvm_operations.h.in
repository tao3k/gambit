frame = ___CONTINUATION_FRAME_FIELD(cont); \
___SET_FP(___ps->context->stack_break) \
___SET_STK(-___BREAK_FRAME_NEXT,frame) \
___CONTINUATION_FRAME_FIELD(___THREAD_CONT_FIELD(thread)) = frame; \
___SET_R0(___ps->handler_break)

