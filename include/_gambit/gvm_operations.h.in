#define ___TICKETLOCK ___ticketlock_struct

#define ___TICKETLOCK_DECL(id) ___TICKETLOCK id;

#define ___TICKETLOCK_INIT_STATIC { ___FIX(0), ___FIX(0) }

#define ___TICKETLOCK_INIT(lock) \
(lock).next_ticket = (lock).current_ticket = ___FIX(0)

#define ___TICKETLOCK_DESTROY(lock)

#define ___TICKETLOCK_LOCK(lock) \
___TICKETLOCK_LOCK2((lock).next_ticket, (lock).current_ticket)

#define ___TICKETLOCK_UNLOCK(lock) \
___TICKETLOCK_UNLOCK2((lock).next_ticket,(lock).current_ticket)

#ifdef ___DEBUG_TICKETLOCK

#define ___TICKETLOCK_LOCK2(next,current) \
do { \
  ___WORD ___ticket = ___WORD_FETCH_ADD_RELAXED(___CAST(___VOLATILE ___WORD*,&next),___FIX(1)); \
  int ___count = 0; \
  while (___WORD_LOAD_ACQUIRE(___CAST(___VOLATILE ___WORD*,&current)) != ___ticket) \
    { \
      if (++___count == 100000000) \
        { \
          ___WORD ___n = ___VMSTATE->ticketlock_history_index; \
          ___WORD ___i = ___n; \
          while (___i > 0 && ___n-___i < ___TICKETLOCK_HISTORY_LENGTH) \
            { \
              ___ticketlock_location *___probe = &___VMSTATE->ticketlock_history[--___i % ___TICKETLOCK_HISTORY_LENGTH]; \
              if (___probe->id == &current && ___probe->lock_op) \
                { \
                  printf("*** ERROR at \"%s\"@%d.1 -- lock attempt on TICKETLOCK %p spinning too long\ndue to successful locking at \"%s\"@%d.1 (current=%d ticket=%d)\n",__FILE__,__LINE__,&current,___probe->location.file,___probe->location.line,___INT(___WORD_LOAD_ACQUIRE(___CAST(___VOLATILE ___WORD*,&current))),___INT(___ticket)); \
                  ___i = -1; \
                } \
            } \
          if (___i != -1) \
            printf("*** ERROR at \"%s\"@%d.1 -- lock attempt on TICKETLOCK %p spinning too long (current=%d ticket=%d)\n",__FILE__,__LINE__,&current,___INT(___WORD_LOAD_ACQUIRE(___CAST(___VOLATILE ___WORD*,&current))),___INT(___ticket)); \
        } \
      ___CPU_RELAX(); \
    } \
  { ___ticketlock_location *___ptr = &___VMSTATE->ticketlock_history[___FETCH_AND_ADD_WORD(&___VMSTATE->ticketlock_history_index,1) % ___TICKETLOCK_HISTORY_LENGTH]; \
    ___ptr->id = &current; \
    ___ptr->lock_op = 1; \
    ___ptr->location.file = __FILE__; \
    ___ptr->location.line = __LINE__; \
    ___SHARED_MEMORY_BARRIER(); \
  } \
} while (0)

#define ___TICKETLOCK_TRYLOCK2(next,current,temp) \
(temp=___WORD_LOAD_ACQUIRE(___CAST(___VOLATILE ___WORD*,&current)), \
 ___WORD_CAS_ACQUIRE(___CAST(___VOLATILE ___WORD*,&next),temp,___FIXWRAPADD(temp,___FIX(1))))

#define ___TICKETLOCK_UNLOCK2(next,current) \
do { \
  if (___WORD_FETCH_ADD_RELEASE(___CAST(___VOLATILE ___WORD*,&current),___FIX(1)) >= ___WORD_LOAD_RELAXED(___CAST(___VOLATILE ___WORD*,&next))) \
    { \
      ___WORD ___n = ___VMSTATE->ticketlock_history_index; \
      ___WORD ___i = ___n; \
      while (___i > 0 && ___n-___i < ___TICKETLOCK_HISTORY_LENGTH) \
        { \
          ___ticketlock_location *___probe = &___VMSTATE->ticketlock_history[--___i % ___TICKETLOCK_HISTORY_LENGTH]; \
          if (___probe->id == &current && !___probe->lock_op) \
            { \
              printf("*** ERROR at \"%s\"@%d.1 -- duplicate unlock attempt on TICKETLOCK %p\nwhich was also unlocked at \"%s\"@%d.1 (current=%d next=%d)\n",__FILE__,__LINE__,&current,___probe->location.file,___probe->location.line,___INT(___WORD_LOAD_ACQUIRE(___CAST(___VOLATILE ___WORD*,&current))),___INT(___WORD_LOAD_RELAXED(___CAST(___VOLATILE ___WORD*,&next)))); \
              ___i = -1; \
            } \
        } \
      if (___i != -1) \
        printf("*** ERROR at \"%s\"@%d.1 -- duplicate unlock attempt on TICKETLOCK %p (current=%d next=%d)\n",__FILE__,__LINE__,&current,___INT(___WORD_LOAD_ACQUIRE(___CAST(___VOLATILE ___WORD*,&current))),___INT(___WORD_LOAD_RELAXED(___CAST(___VOLATILE ___WORD*,&next)))); \
    } \
  { ___ticketlock_location *___ptr = &___VMSTATE->ticketlock_history[___FETCH_AND_ADD_WORD(&___VMSTATE->ticketlock_history_index,1) % ___TICKETLOCK_HISTORY_LENGTH]; \
    ___ptr->id = &current; \
    ___ptr->lock_op = 0; \
    ___ptr->location.file = __FILE__; \
    ___ptr->location.line = __LINE__; \
    ___SHARED_MEMORY_BARRIER(); \
  } \
} while (0)

#else

#define ___TICKETLOCK_LOCK2(next,current) \
do { \
  ___WORD ___ticket = ___WORD_FETCH_ADD_RELAXED(___CAST(___VOLATILE ___WORD*,&next),___FIX(1)); \
  while (___WORD_LOAD_ACQUIRE(___CAST(___VOLATILE ___WORD*,&current)) != ___ticket) \
    ___CPU_RELAX(); \
} while (0)

#define ___TICKETLOCK_TRYLOCK2(next,current,temp) \
(temp=___WORD_LOAD_ACQUIRE(___CAST(___VOLATILE ___WORD*,&current)), \
 ___WORD_CAS_ACQUIRE(___CAST(___VOLATILE ___WORD*,&next),temp,___FIXWRAPADD(temp,___FIX(1))))

#define ___TICKETLOCK_UNLOCK2(next,current) \
___WORD_FETCH_ADD_RELEASE(___CAST(___VOLATILE ___WORD*,&current),___FIX(1))

#endif

