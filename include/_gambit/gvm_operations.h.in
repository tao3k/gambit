/*---------------------------------------------------------------------------*/

/* Inlinable operations (for 'apply' and 'ifjump' GVM instructions) */

/* APPLY-able operations */

#if ___TB_FIXNUM == ___TB

#define ___TYPE(x)___FIX(___TYP(x))
#define ___TYPECAST(x,y)(((x)&~___TMASK)+___INT(y))

#else

#define ___TYPE(x)(___FIXNUMP(x) ? ___FIX(___tFIXNUM) : ___FIX(___TYP(x)))
#define ___TYPECAST(x,y)(___FIXNUMP(x) ? ((y)==___FIX(___tFIXNUM) ? (x) : ___CAST(___WORD,(___CAST(___UWORD,___INT(x))<<___TB)+___INT(y))) : ((y)==___FIX(___tFIXNUM) ? (___INT(x)<<___TB)+___INT(y) : ((x)&~___TMASK)+___INT(y)))

#endif

#define ___SUBTYPE(x)((___HEADER(x)&___SMASK)>>(___HTB-___TB_FIXNUM))
#define ___SUBTYPESET(x,y)___temp=(x);___HEADER_SET(___temp,(___HEADER(___temp)&~___SMASK)+((y)<<(___HTB-___TB_FIXNUM)));

/* IFJUMP-able operations */

#define ___FALSEP(x)((x)==___FAL)
#define ___NOTFALSEP(x)((x)!=___FAL)
#define ___BOOLEANP(x)(((x)&(___TRU-___tSPECIAL+___TMASK))==___TRU)
#define ___NULLP(x)((x)==___NUL)
#define ___FALSEORNULLP(x)(((x)&(___NUL-___tSPECIAL+___TMASK))==___NUL)
#define ___FALSEORVOIDP(x)(((x)&(___VOID-___tSPECIAL+___TMASK))==___VOID)
#define ___UNBOUNDP(x)(((___temp=(x))==___UNB1)||(___temp==___UNB2))
#define ___EQP(x,y)((x)==(y))
#define ___POSSIBLYEQVP(x,y)(___TYP(x) == ___TYP(y))
#define ___POSSIBLYEQUALP(x,y)(___TYP(___temp=(x)) == ___TYP(y) && ___MEM_ALLOCATED(___temp))
#define ___EOFP(x)((x)==___EOF)

/* IFJUMP-able operations */

#define ___IS_ND_FIXNUM(obj) \
(((obj)&___MASK(___WORD,___TB_FIXNUM))==___tFIXNUM)
#define ___FIXNUMP(obj)___HAS_TAG_AND_IS_NOT_DOUBLE(obj, ___tFIXNUM, ___TB_FIXNUM)

#if defined(___NAN_BOXING) || ___tFIXNUM != 0

#define ___FIXNUMSP1(obj)___FIXNUMP(obj)
#define ___FIXNUMSP2(accu,obj)((accu)&&___FIXNUMP(obj))
#define ___FIXNUMSP(accu)accu

#else

#define ___FIXNUMSP1(obj)obj
#define ___FIXNUMSP2(accu,obj)((accu)|(obj))
#define ___FIXNUMSP(accu)___IS_ND_FIXNUM(accu)

#endif

#define ___MEM_ISA(type,obj) \
((___t ## type == ___tSUBTYPED) ? \
 ___TESTSUBTYPE(obj, ___s ## type) : \
 ___TESTTYPE(obj, ___t ## type))

#define ___MEM_ISA_AND_IS_NOT_DOUBLE(type,obj) \
(___HAS_TAG_AND_IS_NOT_DOUBLE(obj, ___t ## type, ___TB) && \
 (___t ## type != ___tSUBTYPED || ___TESTSUBTYPE(obj, ___s ## type)))

#define ___IS_ND_PAIR(obj)___MEM_ISA(PAIR,obj)
#define ___PAIRP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(PAIR,obj)

#define ___IS_ND_VECTOR(obj)___MEM_ISA(VECTOR,obj)
#define ___VECTORP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(VECTOR,obj)

#ifdef ___NAN_BOXING

#define ___IFLONUMP(obj)___FLONUMP(obj)
#define ___FLONUMP(obj)___IS_DOUBLE(obj)
#define ___FLONUMP_DECL

#else

#define ___MEM_ALLOCATED_FLONUM(obj)___MEM_ISA(FLONUM,obj)

#if ___FLONUM_SELF_TAGGING_TAGS == 0

#define ___IFLONUMP(obj)___FLONUMP(obj)
#define ___FLONUMP(obj)___MEM_ALLOCATED_FLONUM(obj)
#define ___FLONUMP_DECL ___WORD ___temp;

#elif ___FLONUM_SELF_TAGGING_TAGS == 1

#define ___IFLONUMP(obj)___SELF_TAGGED_FLONUM(obj)
#define ___FLONUMP(obj)___TESTMASK(obj,6,6)
#define ___FLONUMP_DECL

#elif ___FLONUM_SELF_TAGGING_TAGS == 4

#define ___IFLONUMP(obj)___SELF_TAGGED_FLONUM(obj)
#define ___FLONUMP(obj)(___SELF_TAGGED_FLONUM(___temp=(obj)) || ___MEM_ALLOCATED_FLONUM(obj))
#define ___FLONUMP_DECL ___WORD ___temp;

#else

#define ___IFLONUMP(obj)___SELF_TAGGED_FLONUM(obj)
#define ___FLONUMP(obj)((obj)&2)
#define ___FLONUMP_DECL

#endif

#endif

#if defined(___NAN_BOXING) || ___FLONUM_SELF_TAGGING_TAGS == 4

#define ___FLONUMSP1(obj)___FLONUMP(obj)
#define ___FLONUMSP2(accu,obj)((accu)&&___FLONUMP(obj))
#define ___FLONUMSP(accu)accu

#else

#define ___FLONUMSP1(obj)obj
#define ___FLONUMSP2(accu,obj)((accu)&(obj))

#if ___FLONUM_SELF_TAGGING_TAGS == 0
#define ___FLONUMSP(accu)___TESTMASK(accu,7,7)
#elif ___FLONUM_SELF_TAGGING_TAGS == 1
#define ___FLONUMSP(accu)___TESTMASK(accu,6,6)
#else
#define ___FLONUMSP(accu)___TESTMASK(accu,2,2)
#endif

#endif

#if defined(___NAN_BOXING) || ___FLONUM_SELF_TAGGING_TAGS == 0 || ___FLONUM_SELF_TAGGING_TAGS == 3

#define ___IFLONUMSP1(obj)___IFLONUMP(obj)
#define ___IFLONUMSP2(accu,obj)((accu)&&___IFLONUMP(obj))
#define ___IFLONUMSP(accu)accu

#else

#define ___IFLONUMSP1(obj)(___CAST_U32(obj)+2)
#define ___IFLONUMSP2(accu,obj)((accu)|___IFLONUMSP1(obj))

#if ___FLONUM_SELF_TAGGING_TAGS == 1

#define ___IFLONUMSP(accu)(((accu)&7)==0)

#elif ___FLONUM_SELF_TAGGING_TAGS == 2

#define ___IFLONUMSP(accu)(((accu)&3)==0)

#else

#define ___IFLONUMSP(accu)(((accu)&2)==0)

#endif

#endif

#define ___IS_ND_SPECIAL(obj)___TESTTYPE(obj,___tSPECIAL)
#define ___SPECIALP(obj)___HAS_TAG_AND_IS_NOT_DOUBLE(obj, ___tSPECIAL, ___TB)

#define ___IS_ND_MUTABLE(obj)(___HD_TYP(___HEADER(obj))!=___PERM)
#define ___MUTABLEP(obj)___IS_NOT_DOUBLE_AND(obj,___IS_ND_MUTABLE(obj))

#define ___IS_ND_SUBTYPED(obj)___TESTTYPE(obj,___tSUBTYPED)
#define ___SUBTYPEDP(obj)___HAS_TAG_AND_IS_NOT_DOUBLE(obj, ___tSUBTYPED, ___TB)

#define ___SUBTYPEDMUTABLEP(obj)(___HD_TYP(___SUBTYPED_HEADER(obj))!=___PERM)
#define ___SUBTYPEDVECTORP(obj)___TESTSUBTYPETAG(obj,___sVECTOR)
#define ___SUBTYPEDSYMBOLP(obj)___TESTSUBTYPETAG(obj,___sSYMBOL)
#define ___SUBTYPEDFLONUMP(obj)___TESTSUBTYPETAG(obj,___sFLONUM)
#define ___SUBTYPEDBIGNUMP(obj)___TESTSUBTYPETAG(obj,___sBIGNUM)

#define ___IS_ND_RATNUM(obj)___MEM_ISA(RATNUM,obj)
#define ___RATNUMP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(RATNUM,obj)

#define ___IS_ND_CPXNUM(obj)___MEM_ISA(CPXNUM,obj)
#define ___CPXNUMP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(CPXNUM,obj)

#define ___IS_ND_EXACTINT(obj)(___IS_ND_FIXNUM(obj)||___IS_ND_BIGNUM(obj))
#define ___EXACTINTP(obj)___IS_NOT_DOUBLE_AND(obj,___IS_ND_EXACTINT(obj))

#define ___IS_ND_STRUCTURE(obj)___MEM_ISA(STRUCTURE,obj)
#define ___STRUCTUREP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(STRUCTURE,obj)

#define ___IS_ND_BOX(obj)(___TESTTYPE(___temp=(obj),___tBOXVALUES)&&(___SUBTYPED_HEADER(___temp)&___LSMASK)==___MAKE_HD((___BOX_SIZE<<___LWS),___sBOXVALUES,0))
#define ___BOXP(obj)___IS_NOT_DOUBLE_AND(obj,___IS_ND_BOX(obj))

#define ___IS_ND_VALUES(obj)(___TESTTYPE(___temp=(obj),___tBOXVALUES)&&___TESTSUBTYPETAG(___temp,___sBOXVALUES)&&(___SUBTYPED_HEADER(___temp)&___LSMASK)!=___MAKE_HD((___BOX_SIZE<<___LWS),___sBOXVALUES,0))
#define ___VALUESP(obj)___IS_NOT_DOUBLE_AND(obj,___IS_ND_VALUES(obj))

#define ___IS_ND_MEROON(obj)___MEM_ISA(MEROON,obj)
#define ___MEROONP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(MEROON,obj)

#define ___IS_ND_JAZZ(obj)___MEM_ISA(JAZZ,obj)
#define ___JAZZP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(JAZZ,obj)

#define ___IS_ND_SYMBOL(obj)___MEM_ISA(SYMBOL,obj)
#define ___SYMBOLP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(SYMBOL,obj)

#define ___IS_ND_KEYWORD(obj)___MEM_ISA(KEYWORD,obj)
#define ___KEYWORDP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(KEYWORD,obj)

#define ___IS_ND_SYMKEY(obj)(___IS_ND_SYMBOL(obj)||___IS_ND_KEYWORD(obj))
#define ___SYMKEYP(obj)___IS_NOT_DOUBLE_AND(obj,___IS_ND_SYMKEY(obj))

#define ___IS_ND_FRAME(obj)___MEM_ISA(FRAME,obj)
#define ___FRAMEP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(FRAME,obj)

#define ___IS_ND_CONTINUATION(obj)___MEM_ISA(CONTINUATION,obj)
#define ___CONTINUATIONP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(CONTINUATION,obj)

#define ___IS_ND_PROMISE(obj)___MEM_ISA(PROMISE,obj)
#define ___PROMISEP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(PROMISE,obj)

#define ___IS_ND_WILL(obj)___TESTLENGTHSUBTYPE(obj,(___WILL_SIZE<<___LWS),___sWEAK)
#define ___WILLP(obj)___IS_NOT_DOUBLE_AND(obj,___IS_ND_WILL(obj))

#define ___IS_ND_GCHASHTABLE(obj)(___TESTTYPE(___temp=(obj),___tSUBTYPED)&&___TESTHEADERTAG((___temp=___SUBTYPED_HEADER(___temp)),___sWEAK)&&(___temp&___LSMASK)!=___MAKE_HD((___WILL_SIZE<<___LWS),___sWEAK,0))
#define ___GCHASHTABLEP(obj)___IS_NOT_DOUBLE_AND(obj,___IS_ND_GCHASHTABLE(obj))

#define ___MEMALLOCATEDP(obj)___MEM_ALLOCATED(obj)

#define ___IS_ND_PROCEDURE(obj)___MEM_ISA(PROCEDURE,obj)
#define ___PROCEDUREP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(PROCEDURE,obj)

#define ___IS_ND_SUBPROCEDURE(obj) \
(___PROCEDUREP(obj) && \
 ___LABEL_ENTRY_GET(obj) == obj && \
 !___TESTHEADERTAG(___SUBTYPED_TO_BODY(obj)[-___LABEL_SIZE-1],___sVECTOR))
#define ___SUBPROCEDUREP(obj)___IS_NOT_DOUBLE_AND(obj,___IS_ND_SUBPROCEDURE(obj))

#define ___IS_ND_CLOSURE(obj) \
(___PROCEDUREP(obj) && \
 ___HD_TYP(___SUBTYPED_HEADER(obj)) != ___PERM)
#define ___CLOSUREP(obj)___IS_NOT_DOUBLE_AND(obj,___IS_ND_CLOSURE(obj))

#define ___IS_ND_RETURN(obj)___MEM_ISA(RETURN,obj)
#define ___RETURNP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(RETURN,obj)

#define ___IS_ND_FOREIGN(obj)___MEM_ISA(FOREIGN,obj)
#define ___FOREIGNP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(FOREIGN,obj)

#define ___IS_ND_STRING(obj)___MEM_ISA(STRING,obj)
#define ___STRINGP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(STRING,obj)

#define ___IS_ND_S8VECTOR(obj)___MEM_ISA(S8VECTOR,obj)
#define ___S8VECTORP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(S8VECTOR,obj)

#define ___IS_ND_U8VECTOR(obj)___MEM_ISA(U8VECTOR,obj)
#define ___U8VECTORP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(U8VECTOR,obj)

#define ___IS_ND_S16VECTOR(obj)___MEM_ISA(S16VECTOR,obj)
#define ___S16VECTORP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(S16VECTOR,obj)

#define ___IS_ND_U16VECTOR(obj)___MEM_ISA(U16VECTOR,obj)
#define ___U16VECTORP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(U16VECTOR,obj)

#define ___IS_ND_S32VECTOR(obj)___MEM_ISA(S32VECTOR,obj)
#define ___S32VECTORP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(S32VECTOR,obj)

#define ___IS_ND_U32VECTOR(obj)___MEM_ISA(U32VECTOR,obj)
#define ___U32VECTORP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(U32VECTOR,obj)

#define ___IS_ND_S64VECTOR(obj)___MEM_ISA(S64VECTOR,obj)
#define ___S64VECTORP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(S64VECTOR,obj)

#define ___IS_ND_U64VECTOR(obj)___MEM_ISA(U64VECTOR,obj)
#define ___U64VECTORP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(U64VECTOR,obj)

#define ___IS_ND_F32VECTOR(obj)___MEM_ISA(F32VECTOR,obj)
#define ___F32VECTORP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(F32VECTOR,obj)

#define ___IS_ND_F64VECTOR(obj)___MEM_ISA(F64VECTOR,obj)
#define ___F64VECTORP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(F64VECTOR,obj)

#define ___IS_ND_BIGNUM(obj)___MEM_ISA(BIGNUM,obj)
#define ___BIGNUMP(obj)___MEM_ISA_AND_IS_NOT_DOUBLE(BIGNUM,obj)

#define ___IS_ND_CHAR(obj)(___TESTTYPE(___temp=(obj),___tSPECIAL)&&___temp>=0)
#define ___CHARP(obj)___IS_NOT_DOUBLE_AND(obj,___IS_ND_CHAR(obj))

#define ___NUMBERP(obj)___COMPLEXP(obj)

#ifdef ___NAN_BOXING

#define ___COMPLEXP(obj) \
___IS_DOUBLE_OR(obj, \
                ___FIXNUMP(___temp=(obj)) || \
                (___TESTTYPE(___temp,___tSUBTYPED) && \
                 ((___temp=(___SUBTYPED_HEADER(___temp)&___SMASK))==(___sBIGNUM<<___HTB) || \
                  ___temp==(___sRATNUM<<___HTB) || \
                  ___temp==(___sCPXNUM<<___HTB))))

#else

#if ___tFLONUM == ___tSUBTYPED

#define ___COMPLEXP(obj) \
(___FIXNUMP(___temp=(obj)) || \
 ___SELF_TAGGED_FLONUM(___temp) || \
 (___TESTTYPE(___temp=(obj),___tSUBTYPED) && \
  ((___temp=(___SUBTYPED_HEADER(___temp)&___SMASK))==(___sFLONUM<<___HTB) || \
   ___temp==(___sBIGNUM<<___HTB) || \
   ___temp==(___sRATNUM<<___HTB) || \
   ___temp==(___sCPXNUM<<___HTB))))

#else

#define ___COMPLEXP(obj) \
(___FIXNUMP(___temp=(obj)) || \
 ___FLONUMP(___temp) || \
 (___TESTTYPE(___temp,___tSUBTYPED) && \
  ((___temp=(___SUBTYPED_HEADER(___temp)&___SMASK))==(___sBIGNUM<<___HTB) || \
   ___temp==(___sRATNUM<<___HTB) || \
   ___temp==(___sCPXNUM<<___HTB))))

#endif

#endif

#define ___OBJECTBEFOREP(x,y)((x)<(y))

#define ___FIX_BETWEEN(x,lo,hi)(___UFW(x)-___UFW(lo)<=___UFW(hi)-___UFW(lo))

/* Indexing arrays with a fixnum index */

#define ___FXINDX_SH0(base,i,type) ___CAST(type*,___CAST(___WORD,base)+(i))

#define ___FXINDX_SHL(base,i,type,shift) \
___FXINDX_SH0(base,___CAST(___UWORD,i)<<(shift-___TB_FIXNUM),type)

#define ___FXINDX_SHR(base,i,type,shift) \
___FXINDX_SH0(base,___CAST(___UWORD,i)>>(___TB_FIXNUM-shift),type)

/* Macros to index ___WORD arrays using a fixnum index. */

#if ___TB_FIXNUM == ___LWS
#define ___FXINDX_WORD(base,i) ___FXINDX_SH0(base,i,___WORD)
#elif ___TB_FIXNUM < ___LWS
#define ___FXINDX_WORD(base,i) ___FXINDX_SHL(base,i,___WORD,___LWS)
#else
#define ___FXINDX_WORD(base,i) ___FXINDX_SHR(base,i,___WORD,___LWS)
#endif

#define ___FETCH_WORD_FX(base,i) *___FXINDX_WORD(base,i)
#define ___STORE_WORD_FX(base,i,val) *___FXINDX_WORD(base,i) = val

/* Macros to index ___S64 and ___U64 arrays using a fixnum index. */

#if ___TB_FIXNUM == 3
#define ___FXINDX_S64(base,i) ___FXINDX_SH0(base,i,___S64)
#define ___FXINDX_U64(base,i) ___FXINDX_SH0(base,i,___U64)
#elif ___TB_FIXNUM < 3
#define ___FXINDX_S64(base,i) ___FXINDX_SHL(base,i,___S64,3)
#define ___FXINDX_U64(base,i) ___FXINDX_SHL(base,i,___U64,3)
#else
#define ___FXINDX_S64(base,i) ___FXINDX_SHR(base,i,___S64,3)
#define ___FXINDX_U64(base,i) ___FXINDX_SHR(base,i,___U64,3)
#endif

#define ___FETCH_S64_FX(base,i) *___FXINDX_S64(base,i)
#define ___STORE_S64_FX(base,i,val) *___FXINDX_S64(base,i) = val

#define ___FETCH_U64_FX(base,i) *___FXINDX_U64(base,i)
#define ___STORE_U64_FX(base,i,val) *___FXINDX_U64(base,i) = val

/* Macros to index ___S32 and ___U32 arrays using a fixnum index. */

#ifdef ___S32

#if ___TB_FIXNUM == 2
#define ___FXINDX_S32(base,i) ___FXINDX_SH0(base,i,___S32)
#define ___FXINDX_U32(base,i) ___FXINDX_SH0(base,i,___U32)
#elif ___TB_FIXNUM < 2
#define ___FXINDX_S32(base,i) ___FXINDX_SHL(base,i,___S32,2)
#define ___FXINDX_U32(base,i) ___FXINDX_SHL(base,i,___U32,2)
#else
#define ___FXINDX_S32(base,i) ___FXINDX_SHR(base,i,___S32,2)
#define ___FXINDX_U32(base,i) ___FXINDX_SHR(base,i,___U32,2)
#endif

#define ___FETCH_S32_FX(base,i) *___FXINDX_S32(base,i)
#define ___STORE_S32_FX(base,i,val) *___FXINDX_S32(base,i) = val

#define ___FETCH_U32_FX(base,i) *___FXINDX_U32(base,i)
#define ___STORE_U32_FX(base,i,val) *___FXINDX_U32(base,i) = val

#else

#define ___FETCH_S32_FX(base,i) ___FETCH_S32(base,___INT(i))
#define ___STORE_S32_FX(base,i,val) ___STORE_S32(base,___INT(i),val)

#define ___FETCH_U32_FX(base,i) ___FETCH_U32(base,___INT(i))
#define ___STORE_U32_FX(base,i,val) ___STORE_U32(base,___INT(i),val)

#endif

/* Macros to index ___S16 and ___U16 arrays using a fixnum index. */

#ifdef ___S16

#if ___TB_FIXNUM == 1
#define ___FXINDX_S16(base,i) ___FXINDX_SH0(base,i,___S16)
#define ___FXINDX_U16(base,i) ___FXINDX_SH0(base,i,___U16)
#else
#define ___FXINDX_S16(base,i) ___FXINDX_SHR(base,i,___S16,1)
#define ___FXINDX_U16(base,i) ___FXINDX_SHR(base,i,___U16,1)
#endif

#define ___FETCH_S16_FX(base,i) *___FXINDX_S16(base,i)
#define ___STORE_S16_FX(base,i,val) *___FXINDX_S16(base,i) = val

#define ___FETCH_U16_FX(base,i) *___FXINDX_U16(base,i)
#define ___STORE_U16_FX(base,i,val) *___FXINDX_U16(base,i) = val

#else

#define ___FETCH_S16_FX(base,i) ___FETCH_S16(base,___INT(i))
#define ___STORE_S16_FX(base,i,val) ___STORE_S16(base,___INT(i),val)

#define ___FETCH_U16_FX(base,i) ___FETCH_U16(base,___INT(i))
#define ___STORE_U16_FX(base,i,val) ___STORE_U16(base,___INT(i),val)

#endif

/* Macros to index ___S8 and ___U8 arrays using a fixnum index. */

#ifdef ___S8

#define ___FXINDX_S8(base,i) ___FXINDX_SHR(base,i,___S8,0)
#define ___FXINDX_U8(base,i) ___FXINDX_SHR(base,i,___U8,0)

#define ___FETCH_S8_FX(base,i) *___FXINDX_S8(base,i)
#define ___STORE_S8_FX(base,i,val) *___FXINDX_S8(base,i) = val

#define ___FETCH_U8_FX(base,i) *___FXINDX_U8(base,i)
#define ___STORE_U8_FX(base,i,val) *___FXINDX_U8(base,i) = val

#else

#define ___FETCH_S8_FX(base,i) ___FETCH_S8(base,___INT(i))
#define ___STORE_S8_FX(base,i,val) ___STORE_S8(base,___INT(i),val)

#define ___FETCH_U8_FX(base,i) ___FETCH_U8(base,___INT(i))
#define ___STORE_U8_FX(base,i,val) ___STORE_U8(base,___INT(i),val)

#endif

/* Macros to index ___F32 arrays using a fixnum index. */

#ifdef ___F32

#if ___TB_FIXNUM == 2
#define ___FXINDX_F32(base,i) ___FXINDX_SH0(base,i,___F32)
#elif ___TB_FIXNUM < 2
#define ___FXINDX_F32(base,i) ___FXINDX_SHL(base,i,___F32,2)
#else
#define ___FXINDX_F32(base,i) ___FXINDX_SHR(base,i,___F32,2)
#endif

#define ___FETCH_F32_FX(base,i) *___FXINDX_F32(base,i)
#define ___STORE_F32_FX(base,i,val) *___FXINDX_F32(base,i) = val

#else

#define ___FETCH_F32_FX(base,i) 0.0
#define ___STORE_F32_FX(base,i,val)

#endif

/* Macros to index ___F64 arrays using a fixnum index. */

#if ___TB_FIXNUM == 3
#define ___FXINDX_F64(base,i) ___FXINDX_SH0(base,i,___F64)
#elif ___TB_FIXNUM < 3
#define ___FXINDX_F64(base,i) ___FXINDX_SHL(base,i,___F64,3)
#else
#define ___FXINDX_F64(base,i) ___FXINDX_SHR(base,i,___F64,3)
#endif

#define ___FETCH_F64_FX(base,i) *___FXINDX_F64(base,i)
#define ___STORE_F64_FX(base,i,val) *___FXINDX_F64(base,i) = val

/* Macros to index ___C arrays using a fixnum index. */

#define ___FETCH_C_FX(base,i)___CS_SELECT( \
___FETCH_U8_FX(base,i), \
___FETCH_U16_FX(base,i), \
___FETCH_U32_FX(base,i))
#define ___STORE_C_FX(base,i,val)___CS_SELECT( \
___STORE_U8_FX(base,i,val), \
___STORE_U16_FX(base,i,val), \
___STORE_U32_FX(base,i,val))

/* APPLY-able operations */

#define ___FIX_0 ___FIX(0)
#define ___FIX_1 ___FIX(1)

#define ___FIXPOS(x)___W(x)
#define ___FIXMAX(x,y)(((x)<(y))?(y):(x))
#define ___FIXMIN(x,y)(((x)<(y))?(x):(y))


#define ___FIXWRAPADD(x,y)___W(___FW(___UFW(x)+___UFW(y)))
#define ___FIXADD(x,y)___W(___FW(x)+___FW(y))

#ifndef ___USE_builtin_op_overflow

#define ___FIXADDP(x,y) \
(___temp=___FIXWRAPADD(x,y), \
 ___EXPECT_FALSE(___FW((___temp^(x))&(___temp^(y)))<0) ? ___FAL : ___temp)

#define ___FIXADDP_NOTFALSEP(var,x,y) \
(___temp=___FIXWRAPADD(x,y), \
 ___EXPECT_FALSE(___FW((___temp^(x))&(___temp^(y)))<0) ? 0 : (var=___temp,1))

#else

#define ___FIXADDP_OVERFLOWS(var,x,y) \
___EXPECT_FALSE(__builtin_add_overflow(___FW(x),___FW(y),&var))

#if ___FIXWORD_WIDTH == ___WORD_WIDTH
#define ___FIXADDP(x,y)(___FIXADDP_NOTFALSEP(___temp,x,y)?___temp:___FAL)
#define ___FIXADDP_NOTFALSEP(var,x,y)!___FIXADDP_OVERFLOWS(var,x,y)
#else
#define ___FIXADDP(x,y) \
(___FIXADDP_OVERFLOWS(___FIXTEMP,x,y) ? ___FAL : ___W(___FIXTEMP))
#define ___FIXADDP_NOTFALSEP(var,x,y) \
(___FIXADDP_OVERFLOWS(___FIXTEMP,x,y) ? 0 : (var=___W(___FIXTEMP),1))
#endif

#endif

#define ___FIXADDPCONSTY(x,y) \
((y)==___FIX(0) \
 ? (x) \
 : (y)>___FIX(0) \
   ? (___EXPECT_TRUE(___FIXLE(x,___FIXSUB(___FIX(___MAX_FIX),y))) \
     ? ___FIXADD(x,y) \
     : ___FAL) \
   : ___EXPECT_TRUE(___FIXGE(x,___FIXSUB(___FIX(___MIN_FIX),y))) \
     ? ___FIXADD(x,y) \
     : ___FAL)

#define ___FIXADDPCONSTY_NOTFALSEP(var,x,y) \
((y)==___FIX(0) \
 ? (var=(x),1) \
 : (y)>___FIX(0) \
   ? (___EXPECT_TRUE(___FIXLE(x,___FIXSUB(___FIX(___MAX_FIX),y))) \
     ? (var=___FIXADD(x,y),1) \
     : 0) \
   : ___EXPECT_TRUE(___FIXGE(x,___FIXSUB(___FIX(___MIN_FIX),y))) \
     ? (var=___FIXADD(x,y),1) \
     : 0)

#define ___FIXADDPCONSTX(x,y) ___FIXADDPCONSTY(y,x)
#define ___FIXADDPCONSTX_NOTFALSEP(var,x,y) ___FIXADDPCONSTY_NOTFALSEP(var,y,x)


#define ___FIXWRAPMUL(x,y)___W(___FW(___UFW(x)*___UFW(___INT(y))))
#define ___FIXMUL(x,y)___W(___FW(x)*___FW(___INT(y)))

#ifndef ___USE_builtin_op_overflow

#define ___FIXMULP(x,y) \
(___EXPECT_FALSE(___FIX_BETWEEN(y,___FIX(-1),___FIX(0))) \
 ? ((y)==___FIX(0) ? ___FIX(0) : ___FIXNEGP(x)) \
 : (___temp=___FIXWRAPMUL(x,y), \
    ___EXPECT_FALSE(___FIXQUO(___temp,y)!=(x)) ? ___FAL : ___temp))

#define ___FIXMULP_NOTFALSEP(var,x,y) \
(___EXPECT_FALSE(___FIX_BETWEEN(y,___FIX(-1),___FIX(0))) \
 ? ((y)==___FIX(0) ? (var=___FIX(0),1) : ___FIXNEGP_NOTFALSEP(var,x)) \
 : (___temp=___FIXWRAPMUL(x,y), \
    ___EXPECT_FALSE(___FIXQUO(___temp,y)!=(x)) ? 0 : (var=___temp,1)))

#else

#define ___FIXMULP_OVERFLOWS(var,x,y) \
___EXPECT_FALSE(__builtin_mul_overflow(___FW(x),___FW(___INT(y)),&var))

#if ___FIXWORD_WIDTH == ___WORD_WIDTH
#define ___FIXMULP(x,y)(___FIXMULP_NOTFALSEP(___temp,x,y)?___temp:___FAL)
#define ___FIXMULP_NOTFALSEP(var,x,y)!___FIXMULP_OVERFLOWS(var,x,y)
#else
#define ___FIXMULP(x,y) \
(___FIXMULP_OVERFLOWS(___FIXTEMP,x,y) ? ___FAL : ___W(___FIXTEMP))
#define ___FIXMULP_NOTFALSEP(var,x,y) \
(___FIXMULP_OVERFLOWS(___FIXTEMP,x,y) ? 0 : (var=___W(___FIXTEMP),1))
#endif

#endif

#define ___FIXMULPCONSTY(x,y) \
((y)==___FIX(0) \
 ? ___FIX(0) \
 : (y)>___FIX(0) \
   ? ((y)==___FIX(1) \
      ? (x) \
      : ___EXPECT_TRUE(___FIX_BETWEEN(x,___FIX(___MIN_FIX/___INT(y)),___FIX(___MAX_FIX/___INT(y)))) \
        ? ___FIXMUL(x,y) \
        : ___FAL) \
   : (y)==___FIX(-1) \
     ? ___FIXNEGP(x) \
     : ___EXPECT_TRUE(___FIX_BETWEEN(x,___FIX(___MAX_FIX/___INT(y)),___FIX(___MIN_FIX/___INT(y)))) \
       ? ___FIXMUL(x,y) \
       : ___FAL)

#define ___FIXMULPCONSTY_NOTFALSEP(var,x,y) \
((y)==___FIX(0) \
 ? (var=___FIX(0),1) \
 : (y)>___FIX(0) \
   ? ((y)==___FIX(1) \
      ? (var=(x),1) \
      : ___EXPECT_TRUE(___FIX_BETWEEN(x,___FIX(___MIN_FIX/___INT(y)),___FIX(___MAX_FIX/___INT(y)))) \
        ? (var=___FIXMUL(x,y),1) \
        : 0) \
   : (y)==___FIX(-1) \
     ? (var=___FIXNEGP(x),1) \
     : ___EXPECT_TRUE(___FIX_BETWEEN(x,___FIX(___MAX_FIX/___INT(y)),___FIX(___MIN_FIX/___INT(y)))) \
       ? (var=___FIXMUL(x,y),1) \
       : 0)

#define ___FIXMULPCONSTX(x,y) ___FIXMULPCONSTY(y,x)
#define ___FIXMULPCONSTX_NOTFALSEP(var,x,y) ___FIXMULPCONSTY_NOTFALSEP(var,y,x)


#define ___FIXWRAPSQUARE(x)___FIXWRAPMUL(x,x)
#define ___FIXSQUARE(x)___FIXMUL(x,x)

#define ___FIXSQUAREP_NOTFALSEP(var,x) \
(___EXPECT_FALSE(___UFW(x)+___UFW(___FIX(___SQRT_MAX_FIX))>(___UFW(___FIX(___SQRT_MAX_FIX))<<1)) ? 0 : (var=___FIXSQUARE(x),1))

#define ___FIXSQUAREP(x)(___FIXSQUAREP_NOTFALSEP(___temp,x)?___temp:___FAL)


#define ___FIXWRAPNEG(x)___W(___FW(-___UFW(x)))
#define ___FIXNEG(x)___W(-___FW(x))

#define ___FIXNEGP_NOTFALSEP(var,x) \
(___EXPECT_FALSE((x)==___FIX(___MIN_FIX)) ? 0 : (var=___FIXNEG(x),1))

#define ___FIXNEGP(x) \
(___EXPECT_FALSE((x)==___FIX(___MIN_FIX)) ? ___FAL : ___FIXNEG(x))


#define ___FIXWRAPSUB(x,y)___W(___FW(___UFW(x)-___UFW(y)))
#define ___FIXSUB(x,y)___W(___FW(x)-___FW(y))

#ifndef ___USE_builtin_op_overflow

#define ___FIXSUBP(x,y) \
(___temp=___FIXWRAPSUB(x,y), \
 ___EXPECT_FALSE(___FW((___temp^(x))&((y)^(x)))<0) ? ___FAL : ___temp)

#define ___FIXSUBP_NOTFALSEP(var,x,y) \
(___temp=___FIXWRAPSUB(x,y), \
 ___EXPECT_FALSE(___FW((___temp^(x))&((y)^(x)))<0) ? 0 : (var=___temp,1))

#else

#define ___FIXSUBP_OVERFLOWS(var,x,y) \
___EXPECT_FALSE(__builtin_sub_overflow(___FW(x),___FW(y),&var))

#if ___FIXWORD_WIDTH == ___WORD_WIDTH
#define ___FIXSUBP(x,y)(___FIXSUBP_NOTFALSEP(___temp,x,y)?___temp:___FAL)
#define ___FIXSUBP_NOTFALSEP(var,x,y)!___FIXSUBP_OVERFLOWS(var,x,y)
#else
#define ___FIXSUBP(x,y) \
(___FIXSUBP_OVERFLOWS(___FIXTEMP,x,y) ? ___FAL : ___W(___FIXTEMP))
#define ___FIXSUBP_NOTFALSEP(var,x,y) \
(___FIXSUBP_OVERFLOWS(___FIXTEMP,x,y) ? 0 : (var=___W(___FIXTEMP),1))
#endif

#endif

#define ___FIXSUBPCONSTY(x,y) \
((y)==___FIX(0) \
 ? (x) \
 : (y)>___FIX(0) \
   ? (___EXPECT_TRUE(___FIXGE(x,___FIXADD(___FIX(___MIN_FIX),y))) \
     ? ___FIXSUB(x,y) \
     : ___FAL) \
   : ___EXPECT_TRUE(___FIXLE(x,___FIXADD(___FIX(___MAX_FIX),y))) \
     ? ___FIXSUB(x,y) \
     : ___FAL)

#define ___FIXSUBPCONSTY_NOTFALSEP(var,x,y) \
((y)==___FIX(0) \
 ? (var=(x),1) \
 : (y)>___FIX(0) \
   ? (___EXPECT_TRUE(___FIXGE(x,___FIXADD(___FIX(___MIN_FIX),y))) \
     ? (var=___FIXSUB(x,y),1) \
     : 0) \
   : ___EXPECT_TRUE(___FIXLE(x,___FIXADD(___FIX(___MAX_FIX),y))) \
     ? (var=___FIXSUB(x,y),1) \
     : 0)


#define ___FIXWRAPQUO(x,y)((y)==___FIX(-1)?___FIXWRAPNEG(x):___FIXQUO(x,y))
#define ___FIXWRAPQUOCONSTY(x,y)((y)==___FIX(-1)?___FIXWRAPNEG(x):___FIXQUOCONSTY(x,y))

#if ___WORD_WIDTH == 32 || defined(___HAVE_FAST_DIV64)

#define ___FIXQUO(x,y)___FIX(((x)/(y)))
#define ___FIXQUOCONSTY(x,y)___FIXQUO(x,y)

#define ___FIXREM(x,y)___CAST(___WORD,(x)%(y))
#define ___FIXREMCONSTY(x,y)___FIXREM(x,y)

#else

/*
 * Typical processors have a 32 by 32 integer division instruction
 * that is considerably faster than the 64 by 64 integer division
 * instruction.  The following macros will dynamically check the
 * arguments of the division to determine if a 32 by 32 division will
 * work and use that when possible.  To always use the 64 by 64 bit
 * division, define ___HAVE_FAST_DIV64 when compiling the C code.
 */

#define ___S64_FITS_IN_S32(x)(___CAST(___UWORD,((x)>>31)+1)<2)

#define ___FIXQUO(x,y) \
(___S64_FITS_IN_S32(x) && ___S64_FITS_IN_S32(y) \
 ?___FIX(___CAST(___WORD,___CAST(___S32,x)/___CAST(___S32,y))) \
 :___FIX((x)/(y)))
#define ___FIXQUOCONSTY(x,y) ___FIX((x)/(y))

#define ___FIXREM(x,y) \
(___S64_FITS_IN_S32(x) && ___S64_FITS_IN_S32(y) \
 ?___CAST(___WORD,___CAST(___S32,x)%___CAST(___S32,y))  \
 :___CAST(___WORD,(x)%(y)))
#define ___FIXREMCONSTY(x,y) ___CAST(___WORD,(x)%(y))

#endif

#define ___FIXMOD(x,y) \
((___temp=___FIXREM(x,y)) != ___FIX(0) && \
  ((x)>>(___WORD_WIDTH-1)) != ((y)>>(___WORD_WIDTH-1)) \
 ?___FIXADD(___temp,y) \
 :___temp)
#define ___FIXMODCONSTY(x,y) \
((___temp=___FIXREMCONSTY(x,y)) != ___FIX(0) && \
  ((x)>>(___WORD_WIDTH-1)) != ((y)>>(___WORD_WIDTH-1)) \
 ?___FIXADD(___temp,y) \
 :___temp)


#define ___FIXAND(x,y)((___WORD)((x)&(y)))
#define ___FIXANDC1(x,y)((___WORD)(~(x)&(y)))
#define ___FIXANDC2(x,y)((___WORD)((x)&~(y)))
#define ___FIXEQV(x,y)((___WORD)(((x)^(y))^~___FMASK))
#define ___FIXIOR(x,y)((___WORD)((x)|(y)))
#define ___FIXNAND(x,y)((___WORD)(((x)&(y))^~___FMASK))
#define ___FIXNOR(x,y)((___WORD)(((x)|(y))^~___FMASK))
#define ___FIXNOT(x)((___WORD)((x)^~___FMASK))
#define ___FIXORC1(x,y)((___WORD)(((x)^~___FMASK)|(y)))
#define ___FIXORC2(x,y)((___WORD)((x)|((y)^~___FMASK)))
#define ___FIXXOR(x,y)((___WORD)((x)^(y)))
#define ___FIXIF(x,y,z)((___WORD)(((x)&(y))|(~(x)&(z))))

#define ___FIXWRAPABS(x)((x)<0?___FIXWRAPNEG(x):(x))
#define ___FIXABS(x)((x)<0?___FIXNEG(x):(x))
#define ___FIXABSP_NOTFALSEP(var,x)((x)<0?(___EXPECT_FALSE((x)==___FIX(___MIN_FIX))?0:(var=___FIXNEG(x),1)):(var=(x),1))
#define ___FIXABSP(x)((x)<0?(___EXPECT_FALSE((x)==___FIX(___MIN_FIX))?___FAL:___FIXNEG(x)):(x))

#ifdef ___USE_builtin_popcount

#if ___WORD_WIDTH == ___INT_WIDTH
#define ___POPCOUNT_WORD_TEMP() __builtin_popcount(___CAST(___UWORD,___temp))
#else
#if ___WORD_WIDTH == ___LONG_WIDTH
#define ___POPCOUNT_WORD_TEMP() __builtin_popcountl(___CAST(___UWORD,___temp))
#else
#define ___POPCOUNT_WORD_TEMP() __builtin_popcountll(___CAST(___UWORD,___temp))
#endif
#endif

#else

#define ___MASK_WORD_BYTEWISE(m) (~___CAST(___UWORD,0)/0xff*m)

#define ___POPCOUNT_WORD_TEMP() \
(___temp-=(___temp>>1)&___MASK_WORD_BYTEWISE(0x55),  \
 ___temp=(___temp&___MASK_WORD_BYTEWISE(0x33))+ \
         ((___temp>>2)&___MASK_WORD_BYTEWISE(0x33)), \
 (___MASK_WORD_BYTEWISE(0x01)* \
  (___MASK_WORD_BYTEWISE(0x0f)&(___temp+(___temp>>4)))) >> (___WORD_WIDTH-8))

#endif

#ifdef ___USE_builtin_ffs

#if ___WORD_WIDTH == ___INT_WIDTH
#define ___FFS_WORD_TEMP() __builtin_ffs(___temp)
#else
#if ___WORD_WIDTH == ___LONG_WIDTH
#define ___FFS_WORD_TEMP() __builtin_ffsl(___temp)
#else
#define ___FFS_WORD_TEMP() __builtin_ffsll(___temp)
#endif
#endif

#else

#define ___FFS_WORD_TEMP() \
(___temp==0 ? 0 : (___temp=((___temp-1)&~___temp),___POPCOUNT_WORD_TEMP()+1))

#endif

#ifdef ___USE_builtin_clrsb

#define ___LOG2_WORD_TEMP() ((___WORD_WIDTH-1) - ___CLRSB_WORD_TEMP())

#if ___WORD_WIDTH == ___INT_WIDTH
#define ___CLRSB_WORD_TEMP() __builtin_clrsb(___temp)
#else
#if ___WORD_WIDTH == ___LONG_WIDTH
#define ___CLRSB_WORD_TEMP() __builtin_clrsbl(___temp)
#else
#define ___CLRSB_WORD_TEMP() __builtin_clrsbll(___temp)
#endif
#endif

#else

#define ___SET_ALL_LOWER_BITS_WORD_TEMP_32() \
(___temp|=(___temp>>1), \
 ___temp|=(___temp>>2), \
 ___temp|=(___temp>>4), \
 ___temp|=(___temp>>8), \
 ___temp|=(___temp>>16))

#if ___WORD_WIDTH == 32
#define ___LOG2_WORD_TEMP() \
(___SET_ALL_LOWER_BITS_WORD_TEMP_32(), \
 ___POPCOUNT_WORD_TEMP())
#else
#define ___LOG2_WORD_TEMP() \
(___SET_ALL_LOWER_BITS_WORD_TEMP_32(), \
 ___temp|=(___temp>>32), \
 ___POPCOUNT_WORD_TEMP())
#endif

#endif

#define ___FIXLENGTH(x) \
(((___temp=___INT(x))<0)&&(___temp=~___temp),___FIX(___LOG2_WORD_TEMP()))

#define ___FIXBITCOUNT(x) \
(((___temp=___INT(x))<0)&&(___temp=~___temp),___FIX(___POPCOUNT_WORD_TEMP()))

#define ___FIXFIRSTSETBIT(x) \
(___temp=___INT(x),___FIX(___FFS_WORD_TEMP()-1))

#define ___FIXBITSETP(x,y)((y)&(___CAST(___SCMOBJ,1)<<(___INT(x)+___TB_FIXNUM)))


#define ___FIXWRAPASH(x,y)___FIXASH(x,y)
#define ___FIXWRAPASHP(x,y)((y)<___FIX(0)?((y)>=___FIX(-___FIX_WIDTH)?___FIXASHR(x,-(y)):___FAL):((y)<=___FIX(___FIX_WIDTH)?___FIXWRAPASHL(x,y):___FAL))

#define ___FIXASH(x,y)((y)<___FIX(0)?___FIXASHR(x,(y)>=___FIX(-___FIX_WIDTH)?-(y):___FIX(___FIX_WIDTH)):___FIXASHL(x,(y)<=___FIX(___FIX_WIDTH)?(y):___FIX(___FIX_WIDTH)))
#define ___FIXASHP(x,y)((y)<___FIX(0)?((y)>=___FIX(-___FIX_WIDTH)?___FIXASHR(x,-(y)):___FAL):((y)<=___FIX(___FIX_WIDTH)?___FIXASHLP2(x,y):___FAL))

#define ___FIXWRAPASHL(x,y)___W(___FW(___UFW(x)<<___INT(y)))
#define ___FIXWRAPASHLP(x,y)((y)>=___FIX(0)&&(y)<=___FIX(___FIX_WIDTH)?___FIXWRAPASHL(x,y):___FAL)

#define ___FIXASHL(x,y)___W(___FW(x)<<___INT(y))
#define ___FIXASHLP(x,y)((y)>=___FIX(0)&&(y)<=___FIX(___FIX_WIDTH)?___FIXASHLP2(x,y):___FAL)
#define ___FIXASHLP2(x,y)((x)==(___FW(___temp=___FIXASHL(x,y))>>___INT(y))?___temp:___FAL)

#define ___FIXWRAPASHR(x,y)___FIXASHR(x,y)

#define ___FIXASHR(x,y)___W((___FW(x)>>___INT(y))&~___FMASK)
#define ___FIXASHRP(x,y)((y)>=___FIX(0)?___FIXASHR(x,(y)<=___FIX(___FIX_WIDTH)?(y):___FIX(___FIX_WIDTH)):___FAL)

#define ___FIXWRAPLSHR(x,y)___W(___FW((___UFW(x)>>___INT(y))&~___FMASK))
#define ___FIXWRAPLSHRP(x,y)((y)>=___FIX(0)?___FIXWRAPLSHR(x,(y)<=___FIX(___FIX_WIDTH)?(y):___FIX(___FIX_WIDTH)):___FAL)


#define ___FIXTOCHR(x)(((x)<<(___TB-___TB_FIXNUM))+___tSPECIAL)
#define ___FIXFROMCHR(x)(((x)&~___TMASK)>>(___TB-___TB_FIXNUM))

#define ___MAXCHARCODE ___FIX(___MAX_CHR)


#ifndef ___GET_CPUCYCLECOUNT
#ifdef ___USE___builtin_ia32_rdtscp
#ifdef __GNUC__

#if ___WORD_WIDTH == 64

#define ___GET_CPUCYCLECOUNT ___FIX(___s64_temp)
#define ___CPUCYCLECOUNTSTART \
__asm__ __volatile__ ("cpuid\n\trdtsc\n\tshl $32,%%rdx\n\tor %%rdx,%%rax\n\tmov %%rax,%0\n":"=r"(___s64_temp)::"%rax","%rbx","%rcx","%rdx");
#define ___CPUCYCLECOUNTEND \
__asm__ __volatile__ ("rdtscp\n\tshl $32,%%rdx\n\tor %%rdx,%%rax\n\tmov %%rax,%0\n\tcpuid\n":"=r"(___s64_temp)::"%rax","%rbx","%rcx","%rdx");

#else

#define ___GET_CPUCYCLECOUNT ___FIX(___s32_temp)
#define ___CPUCYCLECOUNTSTART \
__asm__ __volatile__ ("cpuid\n\trdtsc\n\tmov %%eax,%0\n":"=r"(___s32_temp)::"%eax","%ebx","%ecx","%edx");
#define ___CPUCYCLECOUNTEND \
__asm__ __volatile__ ("rdtscp\n\tmov %%eax,%0\n\tcpuid\n":"=r"(___s32_temp)::"%eax","%ebx","%ecx","%edx");

#endif

#endif
#endif
#endif

#ifndef ___GET_CPUCYCLECOUNT
#ifdef ___USE___builtin_readcyclecounter

#if ___WORD_WIDTH == 64

#define ___GET_CPUCYCLECOUNT ___FIX(___s64_temp)
#define ___CPUCYCLECOUNTSTART ___s64_temp = __builtin_readcyclecounter ();
#define ___CPUCYCLECOUNTEND ___s64_temp = __builtin_readcyclecounter ();

#else

#define ___GET_CPUCYCLECOUNT ___FIX(___s32_temp)
#define ___CPUCYCLECOUNTSTART ___s32_temp = __builtin_readcyclecounter ();
#define ___CPUCYCLECOUNTEND ___s32_temp = __builtin_readcyclecounter ();

#endif

#endif

#endif

#ifndef ___GET_CPUCYCLECOUNT

#define ___GET_CPUCYCLECOUNT ___FIX(0)
#define ___CPUCYCLECOUNTSTART
#define ___CPUCYCLECOUNTEND

#endif

