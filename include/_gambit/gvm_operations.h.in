#else

#define ___PRIMITIVELOCK(obj,next,current) ___PRIMLOCK(obj,next,current)
#define ___PRIMITIVETRYLOCK(obj,next,current) ___PRIMTRYLOCK(obj,next,current)
#define ___PRIMITIVEUNLOCK(obj,next,current) ___PRIMUNLOCK(obj,next,current)

#endif


/* Overflow undo may reuse the previous section only while its frames remain
   private to the current continuation.  Capturing a continuation or replacing
   a break frame's NEXT link invalidates that ownership.  Clear the first
   break's eligibility even when stack_break points to a nested break frame;
   the normal break handler will copy frames when undo is no longer safe. */

#define ___INVALIDATE_STACK_OVERFLOW_UNDO \
___FP_SET_STK((___ps->context->stack_start - ___FIRST_BREAK_FRAME_SPACE), \
             -___FIRST_BREAK_FRAME_STACK_MSECTION,0)

#define ___THREAD_SAVE \
___INVALIDATE_STACK_OVERFLOW_UNDO \
if (___R0 == ___ps->handler_break) \
  frame = ___STK(-___BREAK_FRAME_NEXT); \
else \
  { \
    ___SET_STK(-___FRAME_STACK_RA,___R0) \
    ___R0 = ___ps->handler_break; \
    frame = ___CAST(___SCMOBJ,___fp); \
    ___ADJFP(___BREAK_FRAME_SPACE) \
    ___SET_STK(-___BREAK_FRAME_NEXT,frame) \
    ___ps->context->stack_break = ___fp; \
  } \
thread = ___CURRENTTHREAD; \
___CONTINUATION_FRAME_FIELD(___THREAD_CONT_FIELD(thread)) = frame;


#define ___JUMP_THREAD_SAVE1(jump) \
{ ___SCMOBJ proc; \
  ___SCMOBJ thread; \
  ___SCMOBJ frame; \
  ___POP_ARGS1(proc) \
  ___THREAD_SAVE \
  ___PUSH_ARGS1(thread) \
  jump(___SET_NARGS(1),proc) \
}

#define ___JUMP_THREAD_SAVE2(jump) \
{ ___SCMOBJ proc; \
  ___SCMOBJ arg1; \
  ___SCMOBJ thread; \
  ___SCMOBJ frame; \
  ___POP_ARGS2(proc,arg1) \
  ___THREAD_SAVE \
  ___PUSH_ARGS2(thread,arg1) \
  jump(___SET_NARGS(2),proc) \
}

#define ___JUMP_THREAD_SAVE3(jump) \
{ ___SCMOBJ proc; \
  ___SCMOBJ arg1; \
  ___SCMOBJ arg2; \
  ___SCMOBJ thread; \
  ___SCMOBJ frame; \
  ___POP_ARGS3(proc,arg1,arg2) \
  ___THREAD_SAVE \
