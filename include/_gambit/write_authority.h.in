/* One full-word CAS owns generation, admission and all registered permits.
 * No Scheme payload is stored here; these records are not GC root cells.
 * Fixed capacity is admission capacity, not a limit on Scheme continuations.
 */
#ifndef ___NATIVE_SCOPE_CAPACITY
#define ___NATIVE_SCOPE_CAPACITY 64
#endif
#if ___NATIVE_SCOPE_CAPACITY < 1
#error "___NATIVE_SCOPE_CAPACITY must be positive"
#endif
typedef struct ___native_scope_struct
  {
    ___VOLATILE ___WORD gate;
  } ___native_scope;

