#! /usr/bin/env gsi-script
;;; Reconstruction keeps installed references strong until final publication.
(##include "~~lib/_gambit#.scm")
(##namespace ("gambit#tests#smp#gc#hash_construction_roots#" check))

(define (check final-flags legacy?)
  (let* ((roots (vector (vector 'key) (vector 'value)))
         (ht (if legacy?
                 (##gc-hash-table-make 0 1 0 4 5)
                 (##gc-hash-table-reconstruction-begin 1 0 4 5)))
         (key-slot (macro-gc-hash-table-key0))
         (val-slot (macro-gc-hash-table-val0)))
    (##gc-hash-table-field-set! ht key-slot (vector-ref roots 0))
    (##gc)
    (if (not (eq? (vector-ref roots 0)
                  (##gc-hash-table-field-ref ht key-slot)))
        (error "construction lost its installed key"))
    (##gc-hash-table-field-set! ht val-slot (vector-ref roots 1))
    (##gc)
    (if (not (and (eq? (vector-ref roots 0)
                      (##gc-hash-table-field-ref ht key-slot))
                  (eq? (vector-ref roots 1)
                      (##gc-hash-table-field-ref ht val-slot))))
        (error "construction lost installed references"))
    (if (not (eq? ht (##gc-hash-table-reconstruction-commit! ht final-flags)))
        (error "construction commit changed identity"))
    (if (not (= (macro-gc-hash-table-flags ht)
                (##fxior final-flags
                         (macro-gc-hash-table-flag-key-moved)
                         (macro-gc-hash-table-flag-need-rehash))))
        (error "construction commit lost final policy or index debt"))
    (##gc)
    (if (not (and (eq? (vector-ref roots 0)
                      (##gc-hash-table-field-ref ht key-slot))
                  (eq? (vector-ref roots 1)
                      (##gc-hash-table-field-ref ht val-slot))))
        (error "committed table lost strongly retained references"))))

(define (main . args)
  (let ((legacy? (equal? args '("legacy"))))
    (for-each (lambda (flags) (check flags legacy?))
              (map (lambda (weak-flags)
                     (##fxior (macro-gc-hash-table-flag-mem-alloc-keys) weak-flags))
                   (list 0 (macro-gc-hash-table-flag-weak-keys)
                         (macro-gc-hash-table-flag-weak-vals)
                         (##fxior (macro-gc-hash-table-flag-weak-keys)
                                  (macro-gc-hash-table-flag-weak-vals)))))
    (display "HASH-CONSTRUCTION-ROOTS-PASS\n")))
