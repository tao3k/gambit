;;; Mailbox publication shares Scheme values; no isolated Erlang heap assumed.
(define receiver (current-thread))
(define sender
  (make-thread
   (lambda ()
     (let loop ((i 0))
       (if (= i 64) i
           (let ((message (vector i (list i (+ i 1)))))
             (if (= (modulo i 8) 0) (##gc))
             (thread-send receiver message)
             (loop (+ i 1))))))))
(thread-start! sender)
(let loop ((i 0))
  (if (< i 64)
      (let ((message (thread-receive 5 'timeout)))
        (if (eq? message 'timeout) (error "mailbox failed to make progress" i))
        (if (= (modulo i 8) 0) (##gc))
        (if (not (and (= (vector-ref message 0) i)
                      (equal? (vector-ref message 1) (list i (+ i 1)))))
            (error "mailbox root or publication order lost" i message))
        (loop (+ i 1)))))
(if (not (= (thread-join! sender) 64)) (error "sender did not complete"))
(display "MAILBOX-ROOTS-PASS messages=64\n")

;;; Consolidated related scenario; assertions and bounds retained.
;;; Concurrent first publishers must share one identity; preserve per-sender
;;; ordering, original payload identity and all 64 messages without serialization
;;; of the publishers through a test mailbox.
(##namespace ("gambit#tests#smp#scheduler#mailbox#identity#"
              gate changed ready go target senders shared seen deadline wait-go))
(define gate (make-mutex))
(define changed (make-condition-variable))
(define ready 0)
(define go #f)
(define shared (vector 'shared (list 31 32)))
(define seen (make-vector 8 0))
(define (wait-go)
  (mutex-lock! gate)
  (set! ready (+ ready 1))
  (condition-variable-broadcast! changed)
  (let loop ()
    (if (not go) (begin (mutex-unlock! gate changed 5) (mutex-lock! gate) (loop))))
  (mutex-unlock! gate))
(define target
  (make-thread
   (lambda ()
     (wait-go)
     (let loop ((n 0))
       (if (< n 64)
           (let ((m (thread-receive 5 'timeout)))
             (if (not (and (vector? m) (= (vector-length m) 3))) (error "identity publication lost message" n m))
             (let ((id (vector-ref m 0)) (i (vector-ref m 1)))
               (if (not (and (= i (vector-ref seen id)) (eq? shared (vector-ref m 2))))
                   (error "identity or sender order lost" n m))
               (vector-set! seen id (+ i 1)))
             (if (= (modulo n 8) 0) (##gc))
             (loop (+ n 1))))))))
(define senders
  (let loop ((i 0))
    (if (= i 8) '()
        (cons (let ((id i))
                (make-thread (lambda ()
                               (wait-go)
                               (let send ((n 0))
                                 (if (< n 8)
                                     (begin (thread-send target (vector id n shared)) (send (+ n 1))))))))
              (loop (+ i 1))))))
(thread-start! target)
(for-each thread-start! senders)
(define deadline (+ 5 (time->seconds (current-time))))
(let wait ()
  (mutex-lock! gate)
  (if (= ready 9)
      (begin (set! go #t) (condition-variable-broadcast! changed) (mutex-unlock! gate))
      (begin (mutex-unlock! gate changed (seconds->time deadline))
             (if (> (time->seconds (current-time)) deadline) (error "identity publishers not ready" ready))
             (wait))))
(for-each (lambda (t) (if (eq? (thread-join! t 5 'timeout) 'timeout) (error "publisher join timed out"))) senders)
(if (eq? (thread-join! target 5 'timeout) 'timeout) (error "receiver join timed out"))
(if (not (equal? seen '#(8 8 8 8 8 8 8 8))) (error "incomplete identity history" seen))
(display "MAILBOX-IDENTITY-PASS publishers=8 messages=64 shared-aliases\n")
