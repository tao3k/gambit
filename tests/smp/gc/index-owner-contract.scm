(##namespace ("gambit#tests#smp#gc#index_owner_contract#" roots hash-calls counted-hash check exercise))
;; Constructor and collector ownership controls, using the runtime under test.
(define roots
  (let loop ((i 0) (rows '()))
    (if (= i 80) rows
        (loop (+ i 1)
              (cons (cons (string-append "owner-key-" (number->string i))
                          (string-append "owner-value-" (number->string i))) rows)))))
(define hash-calls 0)
(define (counted-hash key) (set! hash-calls (+ hash-calls 1)) 7)
(define (check truth label)
  (if (not truth) (begin (write (list 'FAIL label)) (newline) (exit 1))))
(define (exercise table identity?)
  (for-each (lambda (row) (table-set! table (car row) (cdr row))) roots)
  (check (= (table-length table) 80) 'construction-and-resize)
  (let ((copy (table-copy table)))
    (let ((before hash-calls))
      (##gc)
      (check (= before hash-calls) 'no-user-hash-in-collector))
    (for-each
     (lambda (row)
       (let ((key (if identity? (car row) (string-append (car row) ""))))
         (check (equal? (table-ref table key #f) (cdr row)) 'original-index)
         (check (equal? (table-ref copy key #f) (cdr row)) 'copied-index))) roots)
    (##gc)
    (for-each (lambda (row)
      (check (equal? (table-ref copy (car row) #f) (cdr row)) 'repeated-gc)) roots)))
(exercise (make-table size: 1) #f)
(exercise (make-table size: 1 weak-keys: #t) #f)
(exercise (make-table size: 1 weak-values: #t) #f)
(exercise (make-table size: 1 weak-keys: #t weak-values: #t) #f)
(exercise (make-table size: 1 test: string=?) #f)
(exercise (make-table size: 1 test: string=? hash: counted-hash) #f)
(exercise (make-table size: 1 test: eq?) #t)
(display "gambit.smp.gc.hash-index.owner-contract PASS\n")
