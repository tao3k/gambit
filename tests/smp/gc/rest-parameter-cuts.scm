;;; DEV driver and trace oracle for actual generated handlers 7 and 9.
;;; An observer emits one ordered event stream per activation. It must
;;; supply independently decoded frame/slot expectations, not copy the
;;; producer's slot count into the expected field.
(define (rest-cut-check form mode token events)
  (define (take tag)
    (if (and (pair? events)
             (pair? (car events))
             (eq? tag (caar events))
             (pair? (cdar events))
             (equal? token (cadar events)))
        (let ((payload (cddar events)))
          (set! events (cdr events))
          payload)
        (error "missing, reordered or unrelated rest cut" tag)))
  (define (check condition label)
    (if (not condition) (error "invalid rest cut" label)))
  (define (grant-covers? grant)
    (and (= (length grant) 3) (>= (caddr grant) (cadr grant))))
  (check (memq form '(ordinary keyword-rest rest-keyword)) 'handler)
  (check (memq mode '(exact one-short)) 'mode)
  (let ((before (take 'preflight)))
    (check (and (= (length before) 3)
                (> (cadr before) 0)
                (= (caddr before) (- (cadr before) (if (eq? mode 'exact) 0 1))))
           'initial-grant)
    (if (eq? mode 'one-short)
        (begin
          (check (equal? (take 'refused) '(0 0)) 'writes-or-pops-on-refusal)
          (let* ((installed (take 'roots-installed))
                 (repaired (take 'gc-repaired))
                 (reload (take 'roots-reloaded))
                 (plan (take 'write-plan))
                 (fresh (take 'grant)))
            ;; installed = mapped frame, expected slots, registered slots
            ;; repaired = new round, moved count, scanned slots
            ;; reload = round, reloaded slots, stale reads
            (check (and (= (length installed) 3)
                        (eq? (car installed) 'mapped)
                        (pair? (cadr installed))
                        (equal? (cadr installed) (caddr installed)))
                   'mapped-root-coverage)
            (check (and (= (length repaired) 3)
                        (> (car repaired) (car before))
                        (> (cadr repaired) 0)
                        (equal? (caddr repaired) (cadr installed)))
                   'moving-gc-and-scan)
            (check (equal? reload (list (car repaired) (cadr installed) 0))
                   'post-gc-reload)
            ;; Pair count, pair words, vector slots, vector header, padding.
            ;; Decode these from the emitted retry writes independently of
            ;; the grant. The retry may allocate a vector the fast path omits.
            (check (and (= (length plan) 5)
                        (let loop ((fields plan))
                          (or (null? fields)
                              (and (exact-integer? (car fields))
                                   (>= (car fields) 0)
                                   (loop (cdr fields)))))
                        (or (= (car plan) 0) (> (cadr plan) 0)))
                   'slow-write-plan)
            (let ((words (+ (* (car plan) (cadr plan))
                            (caddr plan) (cadddr plan) (list-ref plan 4))))
              (check (and (grant-covers? fresh)
                          (= (car fresh) (car repaired))
                          (= (cadr fresh) words))
                     'current-grant)))
          (check (null? (take 'ready)) 'ready)
          (check (equal? (take 'claim) '(accepted)) 'first-claim)
          (check (equal? (take 'claim) '(duplicate)) 'replayed-claim)))
    (check (null? (take 'tail-entry)) 'tail-entry)
    (check (equal? (take 'body-entry) (list form)) 'scheme-result)
    (check (null? events) 'extra-events)
    #t))

(define (rest-cut-drive form)
  (let* ((label (vector 'rest-cut-label))
         (selected (vector 'rest-cut-selected))
         (duplicate (vector 'rest-cut-duplicate))
         (keywords (list flag: selected flag: duplicate))
         (tail (let loop ((i 3999) (out (list selected)))
                 (if (< i 0) out (loop (- i 1) (cons i out)))))
         (body-entries 0)
         (observe (lambda (actual-label actual-key actual-tail)
                    (set! body-entries (+ body-entries 1))
                    (let ((expected-tail (if (eq? form 'rest-keyword)
                                             (append keywords tail) tail)))
                      (if (not (and (eq? actual-label label)
                                    (eq? actual-key (if (eq? form 'ordinary) #f selected))))
                          (error "rest label or keyword identity" form))
                      (let loop ((xs expected-tail) (ys actual-tail))
                        (cond ((null? xs)
                               (if (not (null? ys)) (error "rest tail length" form)))
                              ((and (pair? ys) (eqv? (car xs) (car ys)))
                               (loop (cdr xs) (cdr ys)))
                              (else (error "rest tail value or alias" form))))))))
    (case form
      ((ordinary)
       (apply (lambda (x . xs) (observe x #f xs)) label tail))
      ((keyword-rest)
       (apply (lambda (x #!key flag . xs) (observe x flag xs))
              label (append keywords tail)))
      ((rest-keyword)
       ;; This spelling retains keyword arguments in the rest list.
       ;; Use keyword pairs throughout to preserve DSSSL call semantics.
       (let ((pairs (list flag: selected flag: duplicate)))
         (apply (lambda (x #!rest xs #!key flag)
                  (set! body-entries (+ body-entries 1))
                  (if (not (and (eq? x label) (eq? flag selected) (equal? xs pairs)))
                      (error "DSSSL rest result" form)))
                label pairs)))
      (else (error "unknown rest cut driver form" form)))
    (if (not (= body-entries 1)) (error "rest callee body count" body-entries))
    (write (list 'DEV-REST-BODY-ENTRY form body-entries))
    (newline)))

(define rest-cut-current-root (make-parameter #f))

;; Keep live heap references in non-tail caller frames while collecting and
;; invoking a rest procedure on the initial run and two resumptions. A
;; separate native observer must establish which physical sections were read.
(define (rest-cut-deep-drive form)
  (let ((root (vector form))
        (resume #f)
        (completed 0))
    (parameterize ((rest-cut-current-root root))
      (let descend ((depth 4000))
        (if (= depth 0)
            (begin
              (call-with-current-continuation (lambda (k) (set! resume k)))
              (rest-cut-drive form)
              0)
            (let* ((saved (vector depth root))
                   (returned (descend (- depth 1))))
              (if (not (and (= returned (- depth 1))
                            (= (vector-ref saved 0) depth)
                            (eq? (vector-ref saved 1) (rest-cut-current-root))))
                  (error "rest caller frame or dynamic root changed" form depth))
              depth))))
    (if (rest-cut-current-root)
        (error "rest dynamic environment did not unwind" form))
    (set! completed (+ completed 1))
    (if (< completed 3)
        (begin (##gc) (resume #f))
        (begin
          (write (list 'DEV-REST-DEEP-ENTRY form 4000 completed))
          (newline)))))

(define (rest-cut-self-check)
  ;; Synthetic traces validate only the oracle, never the handler.
  (let* ((prefix '((preflight t 4 12000 11999)
                   (refused t 0 0)
                   (roots-installed t mapped (label arg result) (label arg result))
                   (gc-repaired t 5 1 (label arg result))
                   (roots-reloaded t 5 (label arg result) 0)
                   (write-plan t 4000 3 1 1 0)
                   (grant t 5 12002 12002)
                   (ready t)
                   (claim t accepted)
                   (claim t duplicate)
                   (tail-entry t)
                   (body-entry t ordinary)))
         (reject (lambda (trace)
                   (with-exception-catcher
                     (lambda (exn) #t)
                     (lambda () (rest-cut-check 'ordinary 'one-short 't trace) #f))))
         (with-grant (lambda (grant)
                       (map (lambda (event)
                              (if (eq? (car event) 'grant) grant event))
                            prefix))))
    (if (not (and (rest-cut-check 'ordinary 'one-short 't prefix)
                  (rest-cut-check 'keyword-rest 'exact 'k
                    '((preflight k 4 16 16) (tail-entry k) (body-entry k keyword-rest)))
                  (reject (append (list (car prefix) '(refused t 1 0)) (cddr prefix)))
                  (reject (append (list (car prefix) '(refused t 0 1)) (cddr prefix)))
                  (reject (append (list (car prefix) (cadr prefix)
                                    '(roots-installed t mapped (label arg result) (label result)))
                                  (cdddr prefix)))
                  (reject (append prefix '((tail-entry t))))
                  (reject (append (list (car prefix) '(refused other 0 0)) (cddr prefix)))
                  (reject (with-grant '(grant t 5 12002 12001)))
                  (reject (with-grant '(grant t 5 12000 12002)))))
        (error "rest trace oracle self-check failed"))
    (println "DEV-REST-CUT-ORACLE-PASS positives=2 negatives=7")))
