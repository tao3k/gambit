(##namespace ("gambit#tests#smp#gc#primitive_table#" fail port rows table inspect))
(define (fail x) (write x) (newline) (exit 1))
(define port (open-input-file "gsc/_prims.scm"))
(define rows
  (let loop ((form (read port)))
    (cond ((eof-object? form) (fail 'missing-primitive-declaration))
          ((and (pair? form) (eq? (car form) 'define)
                (eq? (cadr form) 'prim-procs))
           (cadr (caddr form)))
          (else (loop (read port))))))
(close-input-port port)
(define table (make-table))
(for-each (lambda (row) (table-set! table (string-append (car row) "") row)) rows)
(define (inspect phase)
  (let ((missing '()))
    (for-each (lambda (row)
      (if (not (table-ref table (string-append (car row) "") #f))
          (set! missing (cons (car row) missing)))) rows)
    (write (list phase (length rows) (table-length table) missing)) (newline)
    (for-each (lambda (name)
      (table-for-each (lambda (k v)
        (if (equal? k name)
            (begin (write (list 'physical-match name (equal?-hash k) (equal?-hash name)))
                   (newline)))) table)) missing)
    (if (pair? missing) (fail 'lookup-inconsistency))))
(inspect 'before-explicit-gc)
(##gc)
(inspect 'after-explicit-gc)
(display "PRIMITIVE-TABLE-PASS\n")
