(declare (standard-bindings) (extended-bindings))
(##namespace ("gambit#tests#smp#gc#index_traversal#" table seen count exercise-moving-keys))
;; The producer has one Scheme writer. GC may run during the visitor, but
;; collection must not make an unchanged table visit a key twice or skip it.
(define table (make-table test: eq?))
(let fill ((i 0))
  (if (< i 97)
      (begin
        (table-set! table (string->symbol (string-append "index-traversal-" (number->string i))) i)
        (fill (+ i 1)))))
(define seen '())
(define count 0)
(table-for-each
 (lambda (key value)
   (if (memq key seen) (error "GC repeated an unchanged table entry" key count))
   (set! seen (cons key seen))
   (set! count (+ count 1))
   (##gc))
 table)
(if (not (= count 97)) (error "GC skipped an unchanged table entry" count))

;; Moving keys exercise invalid address placement as well as a stable cursor.
;; The private native read below has no public table-access prelude. This does
;; not lift the manual's restriction on public same-table operations in a
;; table-for-each visitor, nor admit a concurrent or reentrant writer.
(define (exercise-moving-keys weak?)
  (let* ((keys (let fill ((i 0) (xs '()))
                 (if (= i 97) xs (fill (+ i 1) (cons (vector i) xs)))))
         (tbl (make-table test: eq? weak-keys: weak? weak-values: weak?))
         (seen '())
         (count 0))
    (for-each (lambda (key) (table-set! tbl key key)) keys)
    (let ((gcht (##table-get-eq-gcht tbl (car keys))))
      (table-for-each
       (lambda (key value)
         (if (or (memq key seen) (not (eq? key value)))
             (error "moving-key traversal lost identity" weak? count))
         (set! seen (cons key seen))
         (set! count (+ count 1))
         (##gc)
         (if (not (eq? (##gc-hash-table-ref gcht key) key))
             (error "read-only address-debt lookup failed" weak? count)))
       tbl))
    (if (not (and (= count 97) (= (length keys) 97)
                  (= (length (table->list tbl)) 97)))
        (error "moving-key traversal skipped an entry" weak? count))
    (for-each (lambda (key)
                (if (not (eq? (table-ref tbl key #f) key))
                    (error "relocated key not found" weak?))) keys)
    (if (table-ref tbl (vector -1) #f) (error "missing key was found"))
    ;; The first write, including a value replacement, owns reconstruction.
    ;; Retain all weak keys/values while checking the table and its copy.
    (##gc)
    (table-set! tbl (car keys) 'replacement)
    (if (not (eq? (table-ref tbl (car keys)) 'replacement))
        (error "writer-owned reconstruction lost replacement"))
    (table-set! tbl (car keys))
    (if (or (table-ref tbl (car keys) #f) (not (= (table-length tbl) 96)))
        (error "writer-owned deletion failed"))
    (table-set! tbl (car keys) (car keys))
    (let ((copy (table-copy tbl)))
      (##gc)
      (for-each (lambda (key)
                  (if (not (eq? (table-ref copy key #f) key))
                      (error "copy lost relocated identity key"))) keys))
    (if (not (= (length keys) 97)) (error "weak fixture root retention failed"))))
(exercise-moving-keys #f)
(exercise-moving-keys #t)
(display "INDEX-TRAVERSAL-PASS entries=97\n")
